          "tag": "script",
          "text": "(function () { var form = document.getElementById('formular'); var erfolg = document.getElementById('erfolg'); // Links der Eroj navigieren per Klick und Tastatur Array.prototype.forEach.call(document.querySelectorAll('ero-ligilo[href]'), function (l) { function gehe() { window.location.href = l.getAttribute('href'); } l.addEventListener('click', gehe); l.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); gehe(); } }); }); var felder = [ { input: document.getElementById('name'), fehler: document.getElementById('name-fehler'), gueltig: function (v) { return v.trim().length > 0; } }, { input: document.getElementById('email'), fehler: document.getElementById('email-fehler'), gueltig: function (v) { return /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(v.trim()); } }, { input: document.getElementById('passwort'), fehler: document.getElementById('passwort-fehler'), gueltig: function (v) { return v.length >= 8; } } ]; form.addEventListener('submit', function (e) { e.preventDefault(); var erstesUngueltiges = null; felder.forEach(function (f) { var ok = f.gueltig(f.input.value); f.fehler.hidden = ok; f.input.setAttribute('aria-invalid', ok ? 'false' : 'true'); if (!ok && !erstesUngueltiges) erstesUngueltiges = f.input; }); if (erstesUngueltiges) { erfolg.hidden = true; erstesUngueltiges.focus(); return; } form.reset(); erfolg.hidden = false; }); })();"
