{
  "ero": {
    "id": "ero_01M523F9YZX0X2QDED1XRNM1G4",
    "name": "tabelo",
    "skemo": "ske_01M523FAAXJ1AADZWZ6NQRX83K",
    "description": "A data table: shows many records with the same fields as rows and columns, so a person can compare and find — standards, versions, findings. It styles and extends the platform's own table: the scroll region, the empty state, the sort buttons."
  },
  "skemo": {
    "id": "ske_01M523FAAXJ1AADZWZ6NQRX83K",
    "ero": "ero_01M523F9YZX0X2QDED1XRNM1G4",
    "props": [
      {
        "name": "density",
        "kind": "enum",
        "values": [
          "compact",
          "default",
          "comfortable"
        ],
        "default": "comfortable",
        "description": "The room in every cell (padding and minimum height from spacing and size roles). Spec 029 ②a (A-tabelo-1): three values by the names of the Dimensio density; default lies between compact and comfortable (its room the step between their spacing roles), comfortable stays the default."
      },
      {
        "name": "caption-hidden",
        "kind": "boolean",
        "default": false,
        "description": "Hides the caption from sight; it stays for assistive technology (never without a caption)."
      },
      {
        "name": "sort",
        "kind": "string",
        "description": "The key of the sorted column (the th's data-sort), shown as aria-sort; sorting itself is the application's, the table says sort-change."
      },
      {
        "name": "direction",
        "kind": "enum",
        "values": [
          "ascending",
          "descending"
        ],
        "default": "ascending",
        "description": "The direction of the sorted column."
      },
      {
        "name": "selectable",
        "kind": "boolean",
        "default": false,
        "description": "Spec 046 T3: a first column of fm-markobutono, one per row with a data-key and one in the head for all; the table says select, the application writes data-selected on the rows (as it sets sort)."
      },
      {
        "name": "loading",
        "kind": "boolean",
        "default": false,
        "description": "Spec 046 T3: the rows load: aria-busy on the table and three skeleton rows in the body in place of the rows and before the empty state."
      },
      {
        "name": "sticky-header",
        "kind": "boolean",
        "default": false,
        "description": "Spec 046 T3: the head row stays at the top of the table's own scroll region while the rows scroll; the region scrolls where its height is bounded."
      },
      {
        "name": "lines",
        "kind": "enum",
        "values": [
          "rows",
          "columns",
          "grid",
          "none"
        ],
        "default": "rows",
        "description": "Spec 029 ②a (A-tabelo-1, ②a-6): which lines the table draws between its cells – rows as before, columns, grid (both) or none. Layout, no token: the line keeps the border's colour and width."
      }
    ],
    "states": [
      "rest",
      "hover",
      "focus"
    ],
    "slots": [
      {
        "name": "caption",
        "default": true,
        "text": true,
        "beside": true
      },
      {
        "name": "content"
      },
      {
        "name": "empty",
        "text": true
      }
    ],
    "parts": {
      "caption": {
        "color": {
          "fixed": "color.text.default"
        },
        "typography": {
          "fixed": "typography.label.1"
        }
      },
      "head": {
        "fill": {
          "fixed": "color.background.sunken"
        },
        "color": {
          "fixed": "color.text.default"
        },
        "typography": {
          "fixed": "typography.label.1"
        },
        "layer": {
          "fixed": "elevation.layer.raised"
        }
      },
      "cell": {
        "color": {
          "fixed": "color.text.default"
        },
        "typography": {
          "fixed": "typography.body.2"
        },
        "inline-padding": {
          "by": [
            "density"
          ]
        },
        "height": {
          "by": [
            "density"
          ]
        }
      },
      "row-header": {
        "typography": {
          "fixed": "typography.label.1"
        }
      },
      "region": {
        "radius": {
          "fixed": "radius.role.surface"
        }
      },
      "border": {
        "color": {
          "fixed": "color.border.subtle"
        },
        "width": {
          "fixed": "border.width.default"
        }
      },
      "sort": {
        "fill": {
          "by": [
            "state"
          ]
        },
        "color": {
          "fixed": "color.text.default"
        },
        "radius": {
          "fixed": "radius.role.control"
        }
      },
      "sort-indicator": {
        "size": {
          "fixed": "size.icon.small"
        },
        "color": {
          "fixed": "color.text.subtle"
        }
      },
      "focus-ring": {
        "ring": {
          "fixed": "focus.ring"
        },
        "offset": {
          "fixed": "focus.offset"
        },
        "color": {
          "fixed": "color.focus.inner"
        }
      },
      "skeleton": {
        "fill": {
          "fixed": "color.background.sunken"
        },
        "radius": {
          "fixed": "radius.role.control"
        },
        "height": {
          "fixed": "size.icon.small"
        }
      },
      "foot": {
        "fill": {
          "fixed": "color.background.sunken"
        },
        "color": {
          "fixed": "color.text.default"
        },
        "typography": {
          "fixed": "typography.label.1"
        }
      }
    },
    "bindings": [
      {
        "part": "cell",
        "property": "inline-padding",
        "when": {
          "density": "comfortable"
        },
        "token": "spacing.medium"
      },
      {
        "part": "cell",
        "property": "inline-padding",
        "when": {
          "density": "default"
        },
        "token": "spacing.scale.150"
      },
      {
        "part": "cell",
        "property": "inline-padding",
        "when": {
          "density": "compact"
        },
        "token": "spacing.small"
      },
      {
        "part": "cell",
        "property": "height",
        "when": {
          "density": "comfortable"
        },
        "token": "size.control.large"
      },
      {
        "part": "cell",
        "property": "height",
        "when": {
          "density": "default"
        },
        "token": "size.control.medium"
      },
      {
        "part": "cell",
        "property": "height",
        "when": {
          "density": "compact"
        },
        "token": "size.control.small"
      },
      {
        "part": "sort",
        "property": "fill",
        "when": {
          "state": "rest"
        },
        "token": "color.action.tertiary.rest"
      },
      {
        "part": "sort",
        "property": "fill",
        "when": {
          "state": "hover"
        },
        "token": "color.action.tertiary.hover"
      },
      {
        "part": "sort",
        "property": "fill",
        "when": {
          "state": "focus"
        },
        "token": "color.action.tertiary.rest"
      }
    ],
    "a11y": {
      "role": "table",
      "name": [
        "slot:caption"
      ],
      "states": {},
      "keys": [
        "Enter",
        "Space"
      ],
      "texts": {
        "selectable": {
          "de": "Zeile auswählen",
          "en": "Select row"
        },
        "head-name": {
          "de": "Alle Zeilen auswählen",
          "en": "Select all rows"
        }
      }
    },
    "events": [
      {
        "name": "sort-change",
        "description": "A sortable header was pressed (detail: column, direction); sorting itself is the application's, the table shows sort and direction."
      },
      {
        "name": "select",
        "description": "Spec 046 T3: a selection box was pressed (detail: keys, the data-key of every row the selection would hold, in DOM order); selecting itself is the application's, the table shows data-selected."
      }
    ],
    "goals": [
      {
        "goal": "table",
        "keywords": {
          "en": [
            "table",
            "records",
            "grid",
            "datatable"
          ],
          "de": [
            "tabelle",
            "datensätze",
            "einträge",
            "zeilen"
          ]
        },
        "props": {},
        "regulo": "table-caption-names-the-content"
      },
      {
        "goal": "row-selection",
        "keywords": {
          "en": [
            "selection",
            "selectable"
          ],
          "de": [
            "zeilenauswahl",
            "markieren"
          ]
        },
        "props": {
          "selectable": true
        }
      },
      {
        "goal": "sticky-header",
        "keywords": {
          "en": [
            "sticky",
            "fixed"
          ],
          "de": [
            "fixiert",
            "feste",
            "kopfzeile"
          ]
        },
        "props": {
          "sticky-header": true
        }
      }
    ]
  }
}
