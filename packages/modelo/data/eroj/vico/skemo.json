    "name": "vico",
    "skemo": "ske_01M6X3XMCMCSTBQGD3310SY2BQ",
    "description": "A row: sets any children side by side with the gap of a spacing step between them, aligned across the row and placed along it, and lets them break into a new line where the row is full (wrap). It draws nothing of its own: no colour, no font, no role."
  },
  "skemo": {
    "id": "ske_01M6X3XMCMCSTBQGD3310SY2BQ",
    "ero": "ero_01M6X3XKZB7XZKGW59V7CF9PA4",
    "props": [
      {
        "name": "gap",
        "kind": "enum",
        "values": [
          "xsmall",
          "small",
          "medium",
          "large",
          "xlarge",
          "xxlarge"
        ],
        "default": "medium",
        "description": "The room between the children of the row: a spacing step of core (spacing.xsmall to spacing.xxlarge), never a value of its own; the Ero owns the space between its children (spacing-owned-by-container)."
      },
      {
        "name": "align",
        "kind": "enum",
        "values": [
          "start",
          "center",
          "end",
          "stretch"
        ],
        "default": "center",
        "description": "Where the children stand across the row: at its start, in its middle, at its end, or stretched over it."
      },
      {
        "name": "justify",
        "kind": "enum",
        "values": [
          "start",
          "center",
          "end",
          "space-between"
        ],
        "default": "start",
        "description": "Where the children stand along the row: together at its start, in its middle or at its end, or spread with the first at the start and the last at the end."
      },
      {
        "name": "wrap",
        "kind": "boolean",
        "default": false,
        "description": "Whether the children may break into a new line where the container is too narrow for them; without wrap they stay in one line."
      }
