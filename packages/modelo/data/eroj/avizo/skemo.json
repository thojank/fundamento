    "name": "avizo",
    "skemo": "ske_01M51ZRG2K24R0RFTV8RPJMHBG",
    "description": "A notice: tells the person in the flow of the page what happened or what to watch for — saved, could not save, import not confirmed. Its kind is a word, never colour alone."
  },
  "skemo": {
    "id": "ske_01M51ZRG2K24R0RFTV8RPJMHBG",
    "ero": "ero_01M51ZRFPHM8B0ED97V23SDRRJ",
    "props": [
      {
        "name": "intent",
        "kind": "enum",
        "values": [
          "info",
          "success",
          "warning",
          "danger"
        ],
        "default": "info",
        "description": "What kind of notice: info, success, warning or danger (an error). No neutral: a notice without a kind is text. danger is spoken as an alert, the others as status (G4)."
      },
      {
        "name": "dismissible",
        "kind": "boolean",
        "default": false,
        "description": "Shows a close button (a butono with emphasis low) named by a11y.texts.dismissible; closing hides the notice and says dismiss. The element hides itself and stays in the document; the application removes it on dismiss if it wants."
      }
    ],
    "states": [
      "rest"
    ],
    "slots": [
