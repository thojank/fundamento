{
  "ero": {
    "id": "ero_01M5616FMN3GPB1J421PMMKBZ3",
    "name": "titolo",
    "skemo": "ske_01M5616G0WKZNS96ANV6PG3A7S",
    "description": "A heading: names a page or a section. Its level (1–6) is the structure of the page, its size a type role of the system — chosen apart, so a heading is never picked by its size."
  },
  "skemo": {
    "id": "ske_01M5616G0WKZNS96ANV6PG3A7S",
    "ero": "ero_01M5616FMN3GPB1J421PMMKBZ3",
    "props": [
      {
        "name": "level",
        "kind": "enum",
        "values": ["1", "2", "3", "4", "5", "6"],
        "required": true,
        "description": "The level of the heading in the structure of the page (1 the page, 2 a section, …): what a screen reader reads as the table of contents (Regulo heading-levels-in-order)."
      },
      {
        "name": "size",
        "kind": "enum",
        "values": [
          "display-1",
          "display-2",
          "display-3",
          "headline-1",
          "headline-2",
          "headline-3",
          "headline-4"
        ],
        "description": "The type role of the text, typography.<size>. Without it the level decides: 1 → headline-1, 2 → headline-2, 3 → headline-3, 4 to 6 → headline-4; the display roles are a choice of design."
      }
    ],
    "states": ["rest"],
    "slots": [{ "name": "label", "default": true, "text": true }],
    "parts": {
      "text": {
        "color": { "fixed": "color.text.default" },
        "typography": { "by": ["size"] }
      }
    },
    "bindings": [
      { "part": "text", "property": "typography", "when": { "size": "display-1" }, "token": "typography.display.1" },
      { "part": "text", "property": "typography", "when": { "size": "display-2" }, "token": "typography.display.2" },
      { "part": "text", "property": "typography", "when": { "size": "display-3" }, "token": "typography.display.3" },
      { "part": "text", "property": "typography", "when": { "size": "headline-1" }, "token": "typography.headline.1" },
      { "part": "text", "property": "typography", "when": { "size": "headline-2" }, "token": "typography.headline.2" },
      { "part": "text", "property": "typography", "when": { "size": "headline-3" }, "token": "typography.headline.3" },
      { "part": "text", "property": "typography", "when": { "size": "headline-4" }, "token": "typography.headline.4" }
    ],
    "a11y": {
      "role": "heading",
      "name": ["slot:label"],
      "states": { "level": ["aria-level"] },
      "keys": []
    },
    "goals": [
      {
        "goal": "section-heading",
        "keywords": {
          "en": ["heading", "headline", "subheading"],
          "de": ["überschrift", "zwischenüberschrift", "abschnittsüberschrift"]
        },
        "props": { "level": "2" },
        "regulo": "heading-levels-in-order"
      },
      {
        "goal": "page-title",
        "keywords": {
          "en": ["title", "page-title"],
          "de": ["titel", "seitentitel"]
        },
        "props": { "level": "1" },
        "regulo": "heading-levels-in-order"
      }
    ]
  }
}
