{
  "ero": {
    "id": "ero_01M51ZRFPHM8B0ED97V23SDRRH",
    "name": "insigno",
    "skemo": "ske_01M51ZRG2J1CVQCTEDNBQPZK6D",
    "description": "A badge: names a status in one to three words next to what it describes — draft, in review, valid, 3 violations. Text carries the status, never colour alone."
  },
  "skemo": {
    "id": "ske_01M51ZRG2J1CVQCTEDNBQPZK6D",
    "ero": "ero_01M51ZRFPHM8B0ED97V23SDRRH",
    "props": [
      {
        "name": "intent",
        "kind": "enum",
        "values": [
          "neutral",
          "info",
          "success",
          "warning",
          "danger"
        ],
        "default": "neutral",
        "description": "The kind of status the colours underline; neutral for a plain fact (draft, agent). No brand step: the brand colour says no status (boundary brand-badge)."
      },
      {
        "name": "size",
        "kind": "enum",
        "values": [
          "small",
          "medium"
        ],
        "default": "medium",
        "description": "The minimum height and the inline padding; the text may grow the badge, it has no fixed height."
      }
    ],
    "states": [
      "rest"
    ],
    "slots": [
      {
        "name": "label",
        "default": true,
        "text": true
      },
      {
        "name": "description",
        "text": true,
        "hidden": true
      }
    ],
    "parts": {
      "surface": {
        "fill": {
          "by": [
            "intent"
          ]
        }
      },
      "border": {
        "color": {
          "by": [
            "intent"
          ]
        },
        "width": {
          "fixed": "border.width.default"
        }
      },
      "text": {
