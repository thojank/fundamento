{
  "ero": {
    "id": "ero_01M2XN0PHDBBD6MNFN75DB9NQ5",
    "name": "butono",
    "skemo": "ske_01M2XN0PWS92GP7VFHW161EH0D",
    "description": "A button: starts an action. Its label is always visible, or given as the label prop when only an icon shows."
  },
  "skemo": {
    "id": "ske_01M2XN0PWS92GP7VFHW161EH0D",
    "ero": "ero_01M2XN0PHDBBD6MNFN75DB9NQ5",
    "props": [
      {
        "name": "emphasis",
        "kind": "enum",
        "values": ["high", "medium", "low"],
        "default": "medium",
        "description": "Emphasis: at most one high per container (Regulo one-primary-per-container)."
      },
      {
        "name": "intent",
        "kind": "enum",
        "values": ["neutral", "danger"],
        "default": "neutral",
        "description": "Intent: danger marks an action that destroys data (Regulo destructive-not-primary-color); only with emphasis=high."
      },
      {
        "name": "size",
        "kind": "enum",
        "values": ["small", "medium", "large"],
        "default": "medium",
        "description": "Height, padding, type and icon size; every size is at least size.target.min (Regulo touch-target-min)."
      },
      {
        "name": "type",
        "kind": "enum",
        "values": ["button", "submit", "reset"],
        "default": "button",
        "description": "What the button does in a form."
      },
      {
        "name": "disabled",
        "kind": "boolean",
        "default": false,
        "description": "Not available; skipped by the keyboard."
      },
      {
        "name": "loading",
        "kind": "boolean",
        "default": false,
        "description": "Working: keeps focus, announces busy, ignores activation."
      },
      {
        "name": "full-width",
        "kind": "boolean",
        "default": false,
        "description": "Takes the full inline size of its container."
      },
      {
        "name": "label",
        "kind": "string",
        "description": "Accessible name when the label slot is empty (icon-only); never shown."
      }
    ],
    "states": ["rest", "hover", "pressed", "focus", "disabled", "loading"],
    "slots": [
      { "name": "label", "default": true, "text": true },
      { "name": "icon-start", "decorative": true },
      { "name": "icon-end", "decorative": true }
    ],
    "parts": {
      "surface": { "fill": { "by": ["emphasis", "intent", "state"] } },
      "label": { "color": { "by": ["emphasis", "intent", "state"] }, "typography": { "by": ["size"] } },
      "border": {
        "color": { "by": ["emphasis", "intent", "state"] },
        "width": { "fixed": "border.width.default" }
      },
      "focus-ring": {
        "ring": { "fixed": "focus.ring" },
        "offset": { "fixed": "focus.offset" },
        "color": { "fixed": "color.focus.inner" }
      },
      "icon": { "color": { "sameAs": "label.color" }, "size": { "by": ["size"] } },
      "box": {
        "width": { "fixed": "size.target.min" },
        "height": { "by": ["size"] },
        "inline-padding": { "by": ["size"] },
        "gap": { "fixed": "spacing.small" },
        "radius": { "fixed": "radius.role.control" }
      },
      "motion": {
