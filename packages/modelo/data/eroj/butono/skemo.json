    "a11y": {
      "role": "button",
      "name": ["slot:label", "prop:label"],
      "states": { "disabled": ["aria-disabled"], "loading": ["aria-disabled", "aria-busy"] },
      "keys": ["Enter", "Space"]
    },
    "constraints": [
      {
        "when": { "intent": "danger" },
        "allowed": { "emphasis": ["high"] },
        "kialo": "The danger tokens describe a filled surface and its text; a danger label on a neutral surface has no tokens, and next to another primary action a destructive action is secondary."
      }
    ],
    "goals": [
      {
        "goal": "destructive",
        "keywords": {
          "en": ["delete", "remove", "destroy", "discard"],
          "de": ["löschen", "entfernen", "verwerfen"]
        },
        "props": { "emphasis": "high", "intent": "danger" },
        "regulo": "destructive-not-primary-color"
      },
      {
        "goal": "confirm",
        "keywords": {
          "en": ["save", "submit", "confirm", "continue"],
          "de": ["speichern", "senden", "bestätigen", "weiter"]
        },
        "props": { "emphasis": "high" },
        "regulo": "one-primary-per-container"
      },
      {
