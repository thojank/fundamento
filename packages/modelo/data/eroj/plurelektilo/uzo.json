{
  "$schema": "../../../schema/modelo.schema.json#/$defs/UzoFile",
  "uzo": {
    "id": "uzo_01M5H5HEQBF3NQ5D8QXMEAJB7M",
    "ero": "ero_01M5H5HBHF1R5TVWFGZ3R1A7B5",
    "skemo": "ske_01M5H5HD4N9SNX1YS9MG9SSQ55",
    "purpose": "Chooses several values from a long list, filterable, and shows the chosen ones as removable tags.",
    "instead": [
      {
        "goal": "few-options",
        "keywords": {
          "en": [
            "few-options",
            "four-options",
            "five-options",
            "six-options",
            "seven-options",
            "up-to-seven"
          ],
          "de": [
            "vier",
            "fünf",
            "sechs",
            "sieben",
            "wenige-optionen"
          ]
        },
        "ero": "markobutono",
        "kialo": "Up to seven options read faster as boxes that all stay visible, because a list hides them behind a click; a markobutono per option covers it."
      },
      {
        "goal": "one-value",
        "keywords": {
          "en": [
            "one-value",
            "single-value",
            "one-of-many"
          ],
          "de": [
            "einen-wert",
            "ein-wert",
            "einzelauswahl"
          ]
        },
        "ero": "elektilo",
        "kialo": "One value from a list is the elektilo's, because a single choice needs no count and no tags; with icons it is the listelektilo's, typed the kompletigilo's."
      }
    ],
    "boundary": [
      {
        "case": "create-new-value",
        "action": "ask-human",
        "keywords": {
          "en": [
            "create-new",
            "add-new-value",
            "new-entry"
          ],
          "de": [
            "neu-anlegen",
            "neuer-wert",
            "neuen-eintrag"
          ]
        },
        "kialo": "A value a person makes up on the spot needs a vocabulary behind it, because the list would grow by every typo; a person decides whether a product wants it."
      }
    ],
    "composes": {
      "containers": [
        {
          "name": "form",
          "kialo": "A multi-select without a form has no sender, because the values are only sent with the form."
        },
        {
          "name": "filter-bar",
          "kialo": "Several values of one facet filter a list, because a filter bar sends what stands in it."
        }
      ],
      "with": [
        {
          "ero": "signeto",
          "kialo": "The chosen values stand as removable tags where summary says so, because a tag with its button takes one value away."
        },
        {
          "ero": "butono",
          "kialo": "„Alle abwählen“ is a butono of low emphasis in the list, because clearing is an action with a name."
        },
        {
          "ero": "ikono",
          "kialo": "A chosen option carries the check mark, because the sign is read faster than the word."
        }
      ],
      "never": [
        {
          "ero": "butono",
          "kialo": "A multi-select stands in no slot of a button, because a button is one target with one name."
        }
      ],
      "spacing": {
        "owner": "container",
        "regulo": "spacing-owned-by-container"
      }
    },
    "slots": {
      "label": {
        "accepts": [
          "text"
        ],
        "required": true,
        "max": 1,
        "nesting": 0
      },
      "options": {
        "accepts": [
          "text"
        ],
        "required": true,
        "min": 2,
        "nesting": 0
      },
      "help": {
        "accepts": [
          "text"
        ],
        "max": 1,
        "nesting": 0
      },
      "error": {
        "accepts": [
          "text"
        ],
        "max": 1,
        "nesting": 0
      }
    },
    "layout": {
      "size": "container",
      "wrap": "never"
    },
    "content": [
      {
        "regulo": "field-label-names-the-datum",
        "fixed": false,
        "check": {
          "kind": "not-words",
          "words": {
            "de": [
              "wählen",
              "auswählen",
              "aussuchen"
            ],
            "en": [
              "choose",
              "select",
              "pick"
            ]
          }
        }
      },
      {
        "regulo": "error-says-what-to-do",
        "fixed": true,
        "of": "slot:error",
        "check": {
          "kind": "min-words",
          "count": 3
        }
      },
      {
        "regulo": "help-is-one-sentence",
        "fixed": false,
        "of": "slot:help",
        "check": {
          "kind": "max-sentences",
          "count": 1
        }
      }
    ]
  }
}
