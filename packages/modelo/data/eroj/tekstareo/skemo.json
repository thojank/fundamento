{
  "ero": {
    "id": "ero_01M51T74A6C97AHDY36TV0SXBY",
    "name": "tekstareo",
    "skemo": "ske_01M51T74P5M264XDJJ2XWMJQZT",
    "description": "A text area: takes text that runs over several lines from a person. It always shows its label, grows with its rows, and can show help and an error."
  },
  "skemo": {
    "id": "ske_01M51T74P5M264XDJJ2XWMJQZT",
    "ero": "ero_01M51T74A6C97AHDY36TV0SXBY",
    "props": [
      {
        "name": "kind",
        "kind": "enum",
        "values": [
          "text",
          "code"
        ],
        "default": "text",
        "description": "What kind of text is written: text, or code (source text, Markdown) in the code typography without the platform's spelling check."
      },
      {
        "name": "value",
        "kind": "string",
        "description": "The current text, over several lines."
      },
      {
        "name": "rows",
        "kind": "number",
        "default": 4,
        "description": "How many lines the area shows before it scrolls; it grows only when a person drags it taller."
      },
      {
        "name": "placeholder",
        "kind": "string",
        "description": "An example in the empty area; never the label (Regulo placeholder-not-label)."
      },
      {
        "name": "required",
        "kind": "boolean",
        "default": false,
        "description": "Must be filled in; marked visibly and audibly (Regulo required-marked)."
      },
      {
        "name": "disabled",
        "kind": "boolean",
        "default": false,
        "description": "Not available; skipped by the keyboard."
      },
      {
        "name": "loading",
        "kind": "boolean",
        "default": false,
        "description": "Spec 029 ②b-1 M-5: the application loads or checks (a value saved, a list fetched, a file examined): the field says so (aria-busy, described by a11y.texts loading) and shows the turning spinner; it stays operable."
      },
      {
        "name": "readonly",
        "kind": "boolean",
        "default": false,
        "description": "Readable and focusable, not changeable."
      },
      {
        "name": "invalid",
        "kind": "boolean",
        "default": false,
        "description": "The text is wrong; true whenever the slot error is filled (constraint)."
      },
      {
        "name": "size",
        "kind": "enum",
        "values": [
          "small",
          "medium",
          "large"
        ],
        "default": "medium",
        "description": "The size of the label and the text on the scale of the kampo, so a text area and a field read alike in one form."
      },
      {
        "name": "name",
        "kind": "string",
        "description": "The name in the form; without effect in a design tool."
      },
      {
        "name": "label",
        "kind": "string",
        "shown": true,
        "description": "The visible label written as an attribute (Spec 029 ②b-1b, Nachlese 12): <fm-tekstareo label=\"E-Mail\"> shows it where the label slot's text would stand and names the control by it, so the simplest way to write the field is labelled; the slot's text wins where both are given."
      },
      {
        "name": "intent",
        "kind": "enum",
        "values": [
          "neutral",
          "success",
          "warning",
          "danger"
        ],
        "default": "neutral",
        "description": "Spec 029 ②b-1b M-2: the status of the field, as avizo and insigno name it. warning and success show their message (slot message) and the border of their status; danger is what invalid says – invalid stays its short form, and a filled error slot shows it too."
      },
      {
        "name": "message-position",
        "kind": "enum",
        "values": [
          "below",
          "joined"
        ],
        "default": "below",
        "description": "Spec 029 ②b-1b M-2: where the message and the error stand – below the field with the space of the field, or joined to it without that space. Never only in a tooltip: the message must be seen (error-not-color-only, error-says-what-to-do)."
      }
    ],
    "states": [
      "rest",
      "hover",
      "focus",
      "disabled",
      "invalid",
      "warning",
      "success"
    ],
    "slots": [
      {
        "name": "label",
        "default": true,
        "text": true
      },
      {
        "name": "help",
        "text": true
      },
      {
        "name": "error",
        "text": true
      },
      {
        "name": "message",
        "text": true,
        "beside": true
      },
      {
        "name": "disabled-reason",
        "text": true
      }
    ],
    "parts": {
      "label": {
        "color": {
          "by": [
            "state"
          ]
        },
        "typography": {
          "by": [
            "size"
          ]
        }
      },
      "required-mark": {
        "color": {
          "fixed": "color.status.danger.text"
        }
      },
      "surface": {
        "fill": {
          "by": [
            "state"
          ]
        }
      },
      "border": {
        "color": {
          "by": [
            "state"
          ]
        },
        "width": {
          "fixed": "border.width.default"
        }
      },
      "text": {
        "color": {
          "by": [
            "state"
          ]
        },
        "typography": {
          "by": [
            "kind",
            "size"
          ]
        }
      },
      "placeholder": {
        "color": {
          "fixed": "color.text.subtle"
        }
      },
      "help": {
        "color": {
          "fixed": "color.text.muted"
        },
        "typography": {
          "fixed": "typography.caption"
        }
      },
      "error": {
        "color": {
          "fixed": "color.status.danger.text"
        },
        "typography": {
          "fixed": "typography.caption"
        }
      },
      "focus-ring": {
        "ring": {
          "fixed": "focus.ring"
        },
        "offset": {
          "fixed": "focus.offset"
        },
        "color": {
          "fixed": "color.focus.inner"
        }
      },
      "box": {
        "inline-padding": {
          "by": [
            "size"
          ]
        },
        "gap": {
          "fixed": "spacing.small"
        },
        "radius": {
          "fixed": "radius.role.control"
        }
      },
      "motion": {
        "duration": {
          "fixed": "motion.duration.fast"
        },
        "easing": {
          "fixed": "motion.easing.standard"
        }
      },
      "spinner": {
        "size": {
          "fixed": "size.icon.small"
        },
        "color": {
          "fixed": "color.text.muted"
        },
        "inline-padding": {
          "fixed": "spacing.small"
        }
      },
      "message": {
        "color": {
          "by": [
            "state"
          ]
        },
        "typography": {
          "fixed": "typography.caption"
        }
      }
    },
    "trailing": [
      "spinner"
    ],
    "bindings": [
      {
        "part": "label",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.text.default"
      },
      {
        "part": "label",
        "property": "color",
        "when": {
          "state": "disabled"
        },
        "token": "color.text.disabled"
      },
      {
        "part": "label",
        "property": "typography",
        "when": {
          "size": "small"
        },
        "token": "typography.label.2"
      },
      {
        "part": "label",
        "property": "typography",
        "when": {
          "size": "medium"
        },
        "token": "typography.label.1"
      },
      {
        "part": "label",
        "property": "typography",
        "when": {
          "size": "large"
        },
        "token": "typography.label.1"
      },
      {
        "part": "surface",
        "property": "fill",
        "when": {
          "state": "rest"
        },
        "token": "color.background.default"
      },
      {
        "part": "surface",
        "property": "fill",
        "when": {
          "state": "disabled"
        },
        "token": "color.background.sunken"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.border.default"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "hover"
        },
        "token": "color.border.strong"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "focus"
        },
        "token": "color.border.strong"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "disabled"
        },
        "token": "color.border.disabled"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "invalid"
        },
        "token": "color.status.danger.border"
      },
      {
        "part": "text",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.text.default"
      },
      {
        "part": "text",
        "property": "color",
        "when": {
          "state": "disabled"
        },
        "token": "color.text.disabled"
      },
      {
        "part": "box",
        "property": "inline-padding",
        "when": {
          "size": "small"
        },
        "token": "spacing.small"
      },
      {
        "part": "box",
        "property": "inline-padding",
        "when": {
          "size": "medium"
        },
        "token": "spacing.medium"
      },
      {
        "part": "box",
        "property": "inline-padding",
        "when": {
          "size": "large"
        },
        "token": "spacing.medium"
      },
      {
        "part": "text",
        "property": "typography",
        "when": {
          "kind": "text",
          "size": "small"
        },
        "token": "typography.body.2"
      },
      {
        "part": "text",
        "property": "typography",
        "when": {
          "kind": "text",
          "size": "medium"
        },
        "token": "typography.body.1"
      },
      {
        "part": "text",
        "property": "typography",
        "when": {
          "kind": "text",
          "size": "large"
        },
        "token": "typography.body.1"
      },
      {
        "part": "text",
        "property": "typography",
        "when": {
          "kind": "code",
          "size": "small"
        },
        "token": "typography.code"
      },
      {
        "part": "text",
        "property": "typography",
        "when": {
          "kind": "code",
          "size": "medium"
        },
        "token": "typography.code"
      },
      {
        "part": "text",
        "property": "typography",
        "when": {
          "kind": "code",
          "size": "large"
        },
        "token": "typography.code"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "warning"
        },
        "token": "color.status.warning.border"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "success"
        },
        "token": "color.status.success.border"
      },
      {
        "part": "message",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.text.muted"
      },
      {
        "part": "message",
        "property": "color",
        "when": {
          "state": "warning"
        },
        "token": "color.status.warning.text"
      },
      {
        "part": "message",
        "property": "color",
        "when": {
          "state": "success"
        },
        "token": "color.status.success.text"
      }
    ],
    "a11y": {
      "role": "textbox",
      "name": [
        "slot:label",
        "prop:label"
      ],
      "description": [
        "slot:help",
        "slot:error",
        "slot:message",
        "slot:disabled-reason"
      ],
      "states": {
        "required": [
          "aria-required"
        ],
        "invalid": [
          "aria-invalid"
        ],
        "disabled": [
          "aria-disabled"
        ],
        "readonly": [
          "aria-readonly"
        ],
        "loading": [
          "aria-busy"
        ]
      },
      "keys": [],
      "texts": {
        "required": {
          "de": "erforderlich",
          "en": "required"
        },
        "loading": {
          "de": "lädt",
          "en": "loading"
        }
      }
    },
    "events": [
      {
        "name": "input",
        "description": "The text changes while a person types (the platform's input)."
      }
    ],
    "constraints": [
      {
        "when": {
          "slot:error": "filled"
        },
        "allowed": {
          "invalid": [
            "true"
          ]
        },
        "kialo": "An error text without the error state is a contradiction a screen reader cannot resolve: it reads a fault on a field that says it is fine."
      },
      {
        "when": {
          "disabled": "true"
        },
        "allowed": {
          "readonly": [
            "false"
          ]
        },
        "kialo": "Two reasons why one cannot type are one too many; disabled wins."
      },
      {
        "when": {
          "slot:disabled-reason": "filled"
        },
        "allowed": {
          "disabled": [
            "true"
          ]
        },
        "kialo": "A reason without disabled is a contradiction, because it says why something is blocked that is not."
      },
      {
        "when": {
          "slot:message": "filled"
        },
        "allowed": {
          "intent": [
            "success",
            "warning"
          ]
        },
        "kialo": "A message without a warning or a success has no status to say, because an error stands in the slot error and a hint in help."
      },
      {
        "when": {
          "invalid": "true"
        },
        "allowed": {
          "intent": [
            "neutral",
            "danger"
          ]
        },
        "kialo": "invalid is the short form of danger, because a field is wrong or it is not; with a warning or a success it would say two things at once."
      }
    ],
    "goals": [
      {
        "goal": "multi-line",
        "keywords": {
          "en": [
            "comment",
            "description",
            "reason",
            "paragraph",
            "multiline"
          ],
          "de": [
            "kommentar",
            "beschreibung",
            "begründung",
            "absatz",
            "mehrzeilig"
          ]
        },
        "props": {},
        "regulo": "field-label-visible"
      }
    ]
  }
}
