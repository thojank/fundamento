{
  "ero": {
    "id": "ero_01M55X2W7FMR4C5F279M85EAC2",
    "name": "apartigilo",
    "skemo": "ske_01M55X2WKJTJVMKK7CPB0ZKHFP",
    "description": "A divider: a line that separates groups of content where space alone does not. Horizontal or vertical; a separator for assistive technology, or nothing at all where it only decorates."
  },
  "skemo": {
    "id": "ske_01M55X2WKJTJVMKK7CPB0ZKHFP",
    "ero": "ero_01M55X2W7FMR4C5F279M85EAC2",
    "props": [
      {
        "name": "orientation",
        "kind": "enum",
        "values": ["horizontal", "vertical"],
        "default": "horizontal",
        "description": "horizontal draws the line across its container between groups that stand above each other; vertical draws it along the block axis between groups that stand side by side."
      },
      {
        "name": "decorative",
        "kind": "boolean",
        "default": false,
        "description": "The line only decorates: nothing for assistive technology (role none). Default false: a separator between groups of content."
      },
      {
        "name": "emphasis",
        "kind": "enum",
        "values": ["low", "high"],
        "default": "low",
        "description": "Spec 029 ②a (A-apartigilo-1): the strength of the line – low the fine line inside a card, as before; high the stronger line between sections."
      }
    ],
    "states": ["rest"],
    "slots": [],
    "parts": {
      "line": {
        "color": { "by": ["emphasis"] },
        "width": { "by": ["emphasis"] }
      },
      "box": { "height": { "by": ["orientation"] } }
    },
    "bindings": [
      { "part": "line", "property": "color", "when": { "emphasis": "low" }, "token": "color.border.subtle" },
      { "part": "line", "property": "color", "when": { "emphasis": "high" }, "token": "color.border.default" },
      { "part": "line", "property": "width", "when": { "emphasis": "low" }, "token": "border.width.default" },
      { "part": "line", "property": "width", "when": { "emphasis": "high" }, "token": "border.width.strong" },
      { "part": "box", "property": "height", "when": { "orientation": "horizontal" }, "token": "none" },
      {
        "part": "box",
        "property": "height",
        "when": { "orientation": "vertical" },
        "token": "size.control.medium"
      }
    ],
    "a11y": {
      "role": "separator",
      "name": [],
      "states": {},
      "keys": []
    },
    "goals": [
      {
        "goal": "separate",
        "keywords": {
          "en": ["divider", "separator", "rule"],
          "de": ["trennlinie", "trenner", "trennstrich"]
        },
        "props": {}
      }
    ]
  }
}
