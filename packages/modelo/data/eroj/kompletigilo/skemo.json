    "a11y": {
      "role": "combobox",
      "name": [
        "slot:label",
        "prop:label"
      ],
      "description": [
        "slot:help",
        "slot:error",
        "slot:message",
        "slot:disabled-reason"
      ],
      "states": {
        "selected": [
          "aria-selected"
        ],
        "required": [
          "aria-required"
        ],
        "invalid": [
          "aria-invalid"
        ],
        "disabled": [
          "aria-disabled"
        ],
        "expanded": [
          "aria-expanded"
        ],
        "loading": [
          "aria-busy"
        ]
      },
      "keys": [
        "ArrowUp",
        "ArrowDown",
        "Enter",
        "Escape"
      ],
      "texts": {
        "required": {
          "de": "erforderlich",
          "en": "required"
        },
        "options-empty": {
          "de": "Keine Vorschläge",
          "en": "No suggestions"
        },
        "options-count": {
          "de": "Vorschläge",
          "en": "suggestions"
        },
        "loading": {
          "de": "lädt",
          "en": "loading"
        },
        "clear-name": {
          "de": "{label} leeren",
          "en": "Clear {label}"
        }
      }
    },
    "events": [
      {
        "name": "input",
        "description": "The text in the field changes while a person types (the platform's input)."
      },
      {
        "name": "query",
        "description": "The typed text changed (detail: query): the application may load suggestions for it."
      },
      {
        "name": "change",
        "description": "A suggestion was taken; value is its value."
      }
    ],
    "constraints": [
      {
        "when": {
          "slot:error": "filled"
        },
        "allowed": {
          "invalid": [
            "true"
          ]
        },
        "kialo": "An error text without the error state is a contradiction a screen reader cannot resolve: it reads a fault on a field that says it is fine."
      },
      {
        "when": {
          "slot:disabled-reason": "filled"
        },
        "allowed": {
          "disabled": [
            "true"
          ]
        },
        "kialo": "A reason without disabled is a contradiction, because it says why something is blocked that is not."
      },
      {
        "when": {
          "slot:message": "filled"
        },
        "allowed": {
          "intent": [
            "success",
            "warning"
          ]
        },
        "kialo": "A message without a warning or a success has no status to say, because an error stands in the slot error and a hint in help."
      },
      {
        "when": {
          "invalid": "true"
        },
        "allowed": {
          "intent": [
            "neutral",
            "danger"
          ]
        },
        "kialo": "invalid is the short form of danger, because a field is wrong or it is not; with a warning or a success it would say two things at once."
      }
    ],
    "goals": [
      {
        "goal": "suggest",
        "keywords": {
          "en": [
            "autocomplete",
            "combobox",
            "typeahead",
            "suggestions"
          ],
          "de": [
            "autocomplete",
            "combobox",
            "typeahead",
            "vorschläge",
            "autovervollständigung"
          ]
        },
        "props": {},
        "regulo": "option-labels-distinct"
      }
    ]
