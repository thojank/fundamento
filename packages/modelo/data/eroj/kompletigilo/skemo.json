{
  "ero": {
    "id": "ero_01M56AEZKZ3T15QT01E88Q0HF9",
    "name": "kompletigilo",
    "skemo": "ske_01M56AF004GZ2N13Y6C2K29HDY",
    "description": "A field that suggests matching values while the person types; the value may be one of the suggestions or, if allowed, free text. The field of the kampo with a list of suggestions (a popover of the platform anchored to the field), walked with the arrow keys; the number of suggestions is announced."
  },
  "skemo": {
    "id": "ske_01M56AF004GZ2N13Y6C2K29HDY",
    "ero": "ero_01M56AEZKZ3T15QT01E88Q0HF9",
    "props": [
      {
        "name": "value",
        "kind": "string",
        "description": "The text of the field: the value of a chosen suggestion or, with allow-free, what the person typed. A prop, not a state (E2); which suggestion shows as chosen follows from it (the entry key selected of the slot options, E7)."
      },
      {
        "name": "placeholder",
        "kind": "string",
        "description": "A prompt to type, 'Land eingeben': at least two words (select-placeholder-is-prompt), never a value."
      },
      {
        "name": "required",
        "kind": "boolean",
        "default": false,
        "description": "An option must be chosen before the form is sent; marked visibly and audibly (Regulo required-marked)."
      },
      {
        "name": "invalid",
        "kind": "boolean",
        "default": false,
        "description": "The choice is wrong, a required choice left open; true whenever the slot error is filled (constraint)."
      },
      {
        "name": "size",
        "kind": "enum",
        "values": [
          "small",
          "medium",
          "large"
        ],
        "default": "medium",
        "description": "Height of the field on the scale of the kampo (size.control.*), so a select and a field stand level in one form; the chevron takes size.icon.*."
      },
      {
        "name": "disabled",
        "kind": "boolean",
        "default": false,
        "description": "Not available; skipped by the keyboard, the list does not open."
      },
      {
        "name": "name",
        "kind": "string",
        "description": "The name in the form; without effect in a design tool, like type on the butono."
      },
      {
        "name": "allow-free",
        "kind": "boolean",
        "default": false,
        "description": "The person may keep a text that matches no suggestion; without it the field is invalid until a suggestion is chosen."
      },
      {
        "name": "min-chars",
        "kind": "number",
        "default": 1,
        "description": "How many characters the person types before suggestions are shown."
      },
      {
        "name": "expanded",
        "kind": "boolean",
        "default": false,
        "description": "The list of suggestions is shown. A prop the element writes while the person types and keys through the list; in a design tool the axis that shows the list open."
      },
      {
        "name": "loading",
        "kind": "boolean",
        "default": false,
        "description": "The application loads new suggestions for the typed text (a search on a server): the field says so (aria-busy and a live region with the text of a11y.texts loading) and stays operable; the list keeps what it has until the application sets the new options."
      },
      {
        "name": "clearable",
        "kind": "boolean",
        "default": false,
        "description": "Spec 029 ②b-1 M-6: a clear button in the field, shown while it has a value and is neither disabled nor read-only, named „{label} leeren“; a press empties the value and returns the focus to the field."
      },
      {
        "name": "label",
        "kind": "string",
        "shown": true,
        "description": "The visible label written as an attribute (Spec 029 ②b-1b, Nachlese 12): <fm-kompletigilo label=\"E-Mail\"> shows it where the label slot's text would stand and names the control by it, so the simplest way to write the field is labelled; the slot's text wins where both are given."
      },
      {
        "name": "intent",
        "kind": "enum",
        "values": [
          "neutral",
          "success",
          "warning",
          "danger"
        ],
        "default": "neutral",
        "description": "Spec 029 ②b-1b M-2: the status of the field, as avizo and insigno name it. warning and success show their message (slot message) and the border of their status; danger is what invalid says – invalid stays its short form, and a filled error slot shows it too."
      },
      {
        "name": "message-position",
        "kind": "enum",
        "values": [
          "below",
          "joined"
        ],
        "default": "below",
        "description": "Spec 029 ②b-1b M-2: where the message and the error stand – below the field with the space of the field, or joined to it without that space. Never only in a tooltip: the message must be seen (error-not-color-only, error-says-what-to-do)."
      }
    ],
    "states": [
      "rest",
      "hover",
      "focus",
      "disabled",
      "invalid",
      "warning",
      "success"
    ],
    "slots": [
      {
        "name": "label",
        "default": true,
        "text": true
      },
      {
        "name": "options",
        "text": true,
        "entry": {
          "key": "selected",
          "equals": "value",
          "active": "active"
        }
      },
      {
        "name": "help",
        "text": true
      },
      {
        "name": "error",
        "text": true
      },
      {
        "name": "message",
        "text": true,
        "beside": true
      },
      {
        "name": "disabled-reason",
        "text": true
      }
    ],
