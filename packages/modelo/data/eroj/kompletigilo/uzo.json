{
  "$schema": "../../../schema/modelo.schema.json#/$defs/UzoFile",
  "uzo": {
    "id": "uzo_01M56AF0CDZ5SFJYKYEF7VSNPT",
    "ero": "ero_01M56AEZKZ3T15QT01E88Q0HF9",
    "skemo": "ske_01M56AF004GZ2N13Y6C2K29HDY",
    "purpose": "A field that suggests matching values while the person types; the value may be one of the suggestions or, if allowed, free text.",
    "instead": [
      {
        "goal": "few-fixed-options",
        "keywords": {
          "en": [
            "handful"
          ],
          "de": [
            "handvoll"
          ]
        },
        "ero": "elekto",
        "kialo": "A handful of fixed options is a radio group, because a person sees them all at once and chooses without typing; suggestions help where the list is long."
      },
      {
        "goal": "many-fixed-options-no-typing",
        "keywords": {
          "en": [
            "fixedlist"
          ],
          "de": [
            "festeliste"
          ]
        },
        "ero": "elektilo",
        "kialo": "A fixed list that typing does not shorten is a select, because the platform's list is enough and a person opens it with one click; suggestions help where the person knows a part of the word."
      }
    ],
    "boundary": [
      {
        "case": "multi-select",
        "action": "ask-human",
        "keywords": {
          "en": [
            "multiselect",
            "multiple"
          ],
          "de": [
            "mehrfachauswahl",
            "mehrere"
          ]
        },
        "kialo": "Several values in one field need chips, a way to remove each and a way to say them all, because the field holds one text; a person decides until a multi-select Ero comes."
      },
      {
        "case": "tags",
        "action": "not-supported",
        "keywords": {
          "en": [
            "tags",
            "chips"
          ],
          "de": [
            "tags",
            "schlagwörter"
          ]
        },
        "kialo": "Free tags typed one after another are a pattern of their own with a vocabulary behind them; Fundamento does not support them (Spec 014: Freitext-Tags are outside the scope)."
      }
    ],
    "composes": {
      "containers": [
        {
          "name": "form",
          "kialo": "A field with suggestions stands in a form among the other fields, because its value is sent with them."
        }
      ],
      "with": [
        {
          "ero": "butono",
          "kialo": "A form with a field of suggestions is sent by a button, because the suggestions fill the field and the button sends the form."
        },
        {
          "ero": "kampo",
          "kialo": "A field with suggestions stands beside plain fields, because it is one of them with a list that helps typing."
        }
      ],
      "never": [],
      "spacing": {
        "owner": "container",
        "regulo": "spacing-owned-by-container"
      }
    },
    "slots": {
      "label": {
        "accepts": [
          "text"
        ],
        "required": true,
        "max": 1,
        "nesting": 0
      },
      "options": {
        "accepts": [
          "text"
        ],
        "required": true,
        "min": 1,
        "nesting": 0
      },
      "help": {
        "accepts": [
          "text"
        ],
        "max": 1,
        "nesting": 0
      },
      "error": {
        "accepts": [
          "text"
        ],
        "max": 1,
        "nesting": 0
      }
    },
    "layout": {
      "size": "container",
      "wrap": "never"
    },
    "content": [
      {
        "regulo": "option-labels-distinct",
        "fixed": true,
        "of": "slot:options",
        "check": {
          "kind": "distinct"
        }
      },
      {
        "regulo": "select-placeholder-is-prompt",
        "fixed": false,
        "of": "prop:placeholder",
        "check": {
          "kind": "min-words",
          "count": 2
        }
      },
      {
        "regulo": "field-label-names-the-datum",
        "fixed": false,
        "check": {
          "kind": "not-words",
          "words": {
            "de": [
              "auswählen",
              "wählen",
              "wähle"
            ],
            "en": [
              "choose",
              "select",
              "pick"
            ]
          }
        }
      },
      {
        "regulo": "error-says-what-to-do",
        "fixed": true,
        "of": "slot:error",
        "check": {
          "kind": "min-words",
          "count": 3
        }
      },
      {
        "regulo": "help-is-one-sentence",
        "fixed": false,
        "of": "slot:help",
        "check": {
          "kind": "max-sentences",
          "count": 1
        }
      }
    ]
  }
}
