{
  "ero": {
    "id": "ero_01M56F6F0ZVC9VKZS57S5K58CH",
    "name": "pagxigilo",
    "skemo": "ske_01M56F6FCXT3N0K796HNN80PD5",
    "description": "A pagination: moves through the pages of a long list and shows which page is current. Its items are the pages as numbers, the current one marked by more than colour, with an arrow back and forth; a landmark of its own, named."
  },
  "skemo": {
    "id": "ske_01M56F6FCXT3N0K796HNN80PD5",
    "ero": "ero_01M56F6F0ZVC9VKZS57S5K58CH",
    "props": [
      {
        "name": "page",
        "kind": "string",
        "required": true,
        "description": "The current page, counted from 1: the item whose number is this value is the current one (SkemoSlot.entry current). A string like the navigado's page, read as a number by the element."
      },
      {
        "name": "total-pages",
        "kind": "number",
        "required": true,
        "description": "How many pages there are; the last page's number. The element draws the first, the last, the current and its siblings, an ellipsis for every gap."
      },
      {
        "name": "label",
        "kind": "string",
        "description": "The name of the landmark (Seitenblättern), heard, never seen; empty, the words of the Modelo stand in (a11y.texts label-empty)."
      },
      {
        "name": "mode",
        "kind": "enum",
        "values": [
          "button",
          "link"
        ],
        "default": "button",
        "description": "button: every item is a button and a chosen page fires page-change (cancelable) with the number; link: every item is a link to href-template with {page} replaced, the platform moves."
      },
      {
        "name": "href-template",
        "kind": "string",
        "default": "?page={page}",
        "description": "The destination of an item in mode link, {page} replaced by its number."
      },
      {
        "name": "siblings",
        "kind": "number",
        "default": 1,
        "description": "How many pages stand on either side of the current one before an ellipsis; the first and the last page always stand."
      }
    ],
    "states": [
      "rest",
      "hover",
      "focus",
      "disabled"
    ],
    "slots": [
      {
        "name": "items",
        "default": true,
        "text": true,
        "entry": {
          "key": "current",
          "equals": "page"
        }
      }
    ],
    "parts": {
