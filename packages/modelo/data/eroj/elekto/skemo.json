{
  "ero": {
    "id": "ero_01M4WT0RA8VHA64P4RFHAEBK1Q",
    "name": "elekto",
    "skemo": "ske_01M4WT0RNX8N08R3K1G9V0W6ZN",
    "description": "A radio group: chooses one of a few options that all stay visible. Its label names the question and always shows; every option is a circle with its own label, the chosen one filled. It can be required and show help and an error."
  },
  "skemo": {
    "id": "ske_01M4WT0RNX8N08R3K1G9V0W6ZN",
    "ero": "ero_01M4WT0RA8VHA64P4RFHAEBK1Q",
    "props": [
      {
        "name": "value",
        "kind": "string",
        "description": "The value of the chosen option, or empty while none is chosen. A prop, not a state (E2): it holds the answer; which option shows as chosen follows from it (the entry key selected of the slot options, E7)."
      },
      {
        "name": "required",
        "kind": "boolean",
        "default": false,
        "description": "An option must be chosen before the form is sent; marked visibly and audibly (Regulo required-marked)."
      },
      {
        "name": "invalid",
        "kind": "boolean",
        "default": false,
        "description": "The answer is wrong, a required choice left open; true whenever the slot error is filled (constraint)."
      },
      {
        "name": "size",
        "kind": "enum",
        "values": [
          "small",
          "medium",
          "large"
        ],
        "default": "medium",
        "description": "Circles, dots and labels on the scale of the kampo: the dot takes size.icon.*, the circle is the dot box plus its border."
      },
      {
        "name": "disabled",
        "kind": "boolean",
        "default": false,
        "description": "Not available; skipped by the keyboard, no option can be chosen."
      },
      {
        "name": "name",
        "kind": "string",
        "description": "The name in the form; without effect in a design tool, like type on the butono."
      },
      {
        "name": "orientation",
        "kind": "enum",
        "values": [
          "vertical",
          "horizontal"
        ],
        "default": "vertical",
        "description": "The options one below the other, or side by side on one line that never breaks; side by side only for up to three short options (Uzo). Layout, no token: it keys no part."
      }
    ],
    "states": [
      "rest",
      "hover",
      "focus",
      "disabled",
      "invalid"
    ],
    "slots": [
      {
        "name": "label",
        "default": true,
        "text": true,
        "beside": true
      },
      {
        "name": "options",
        "text": true,
        "beside": true,
        "entry": {
          "key": "selected",
          "equals": "value"
        }
      },
      {
        "name": "help",
        "text": true,
        "beside": true
      },
      {
        "name": "error",
        "text": true,
        "beside": true
      }
    ],
    "parts": {
      "label": {
        "color": {
          "by": [
            "state"
          ]
        },
        "typography": {
          "by": [
            "size"
          ]
        }
      },
      "option-label": {
        "color": {
          "by": [
            "state"
          ]
        },
        "typography": {
          "by": [
            "size"
          ]
        }
      },
      "required-mark": {
        "color": {
          "fixed": "color.status.danger.text"
        }
      },
      "help": {
        "color": {
          "fixed": "color.text.muted"
        },
        "typography": {
          "fixed": "typography.caption"
        }
      },
      "error": {
        "color": {
          "fixed": "color.status.danger.text"
        },
        "typography": {
          "fixed": "typography.caption"
        }
      },
      "surface": {
        "fill": {
          "by": [
            "selected",
            "state"
          ]
        }
      },
      "border": {
        "color": {
          "by": [
            "state"
          ]
        },
        "width": {
          "fixed": "border.width.default"
        }
      },
      "box": {
        "gap": {
          "fixed": "spacing.small"
        },
        "radius": {
          "fixed": "radius.role.pill"
        }
      },
      "indicator": {
        "color": {
          "by": [
            "selected"
          ]
        },
        "size": {
          "by": [
            "size"
          ]
        }
      },
      "options": {
        "gap": {
          "fixed": "spacing.medium"
        }
      },
      "focus-ring": {
        "ring": {
          "fixed": "focus.ring"
        },
        "offset": {
          "fixed": "focus.offset"
        },
        "color": {
          "fixed": "color.focus.inner"
        }
      },
      "motion": {
        "duration": {
          "fixed": "motion.duration.fast"
        },
        "easing": {
          "fixed": "motion.easing.standard"
        }
      }
    },
    "bindings": [
      {
        "part": "label",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.text.default"
      },
      {
        "part": "label",
        "property": "color",
        "when": {
          "state": "disabled"
        },
        "token": "color.text.disabled"
      },
      {
        "part": "label",
        "property": "typography",
        "when": {
          "size": "small"
        },
        "token": "typography.label.2"
      },
      {
        "part": "label",
        "property": "typography",
        "when": {
          "size": "medium"
        },
        "token": "typography.label.1"
      },
      {
        "part": "label",
        "property": "typography",
        "when": {
          "size": "large"
        },
        "token": "typography.label.1"
      },
      {
        "part": "option-label",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.text.default"
      },
      {
        "part": "option-label",
        "property": "color",
        "when": {
          "state": "disabled"
        },
        "token": "color.text.disabled"
      },
      {
        "part": "option-label",
        "property": "typography",
        "when": {
          "size": "small"
        },
        "token": "typography.body.2"
      },
      {
        "part": "option-label",
        "property": "typography",
        "when": {
          "size": "medium"
        },
        "token": "typography.body.1"
      },
      {
        "part": "option-label",
        "property": "typography",
        "when": {
          "size": "large"
        },
        "token": "typography.body.1"
      },
      {
        "part": "surface",
        "property": "fill",
        "when": {
          "selected": "true",
          "state": "rest"
        },
        "token": "color.action.primary.rest"
      },
      {
        "part": "surface",
        "property": "fill",
        "when": {
          "selected": "true",
          "state": "hover"
        },
        "token": "color.action.primary.hover"
      },
      {
        "part": "surface",
        "property": "fill",
        "when": {
          "selected": "true",
          "state": "disabled"
        },
        "token": "color.action.primary.disabled"
      },
      {
        "part": "surface",
        "property": "fill",
        "when": {
          "selected": "false",
          "state": "rest"
        },
        "token": "color.background.default"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.border.strong"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "disabled"
        },
        "token": "color.border.disabled"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "invalid"
        },
        "token": "color.status.danger.border"
      },
      {
        "part": "indicator",
        "property": "color",
        "when": {
          "selected": "true"
        },
        "token": "color.action.primary.text"
      },
      {
        "part": "indicator",
        "property": "color",
        "when": {
          "selected": "false"
        },
        "token": "none"
      },
      {
        "part": "indicator",
        "property": "size",
        "when": {
          "size": "small"
        },
        "token": "size.icon.small"
      },
      {
        "part": "indicator",
        "property": "size",
        "when": {
          "size": "medium"
        },
        "token": "size.icon.medium"
      },
      {
        "part": "indicator",
        "property": "size",
        "when": {
          "size": "large"
        },
        "token": "size.icon.large"
      }
    ],
    "a11y": {
      "role": "radiogroup",
      "name": [
        "slot:label"
      ],
      "description": [
        "slot:help",
        "slot:error"
      ],
      "states": {
        "selected": [
          "aria-checked"
        ],
        "required": [
          "aria-required"
        ],
        "invalid": [
          "aria-invalid"
        ],
        "disabled": [
          "aria-disabled"
        ],
        "orientation": [
          "aria-orientation"
        ]
      },
      "keys": [
        "ArrowUp",
        "ArrowDown",
        "ArrowLeft",
        "ArrowRight",
        "Space"
      ],
      "texts": {
        "required": {
          "de": "erforderlich",
          "en": "required"
        }
      }
    },
    "events": [
      {
        "name": "input",
        "description": "Another option is chosen; value is its value."
      },
      {
        "name": "change",
        "description": "Another option was chosen, as a radio group says it."
      }
    ],
    "constraints": [
      {
        "when": {
          "slot:error": "filled"
        },
        "allowed": {
          "invalid": [
            "true"
          ]
        },
        "kialo": "An error text without the error state is a contradiction a screen reader cannot resolve: it reads a fault on a field that says it is fine."
      }
    ],
    "goals": [
      {
        "goal": "choose-few",
        "keywords": {
          "en": [
            "choose",
            "pick",
            "option",
            "options",
            "which",
            "radio"
          ],
          "de": [
            "wähle",
            "wählen",
            "option",
            "optionen",
            "variante",
            "welche",
            "radiobutton",
            "optionsfeld"
          ]
        },
        "props": {},
        "regulo": "elekto-options-few"
      }
    ]
  }
}
