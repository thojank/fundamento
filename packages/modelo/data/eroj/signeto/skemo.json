{
  "ero": {
    "id": "ero_01M5H5HAQKTAM4QNSA6XRERW1D",
    "name": "signeto",
    "skemo": "ske_01M5H5HCBMBZGJ357PGT0CYX3J",
    "description": "A tag: labels something with a category or a keyword; selectable it is a filter that stays pressed, removable it carries a button that takes it away."
  },
  "skemo": {
    "id": "ske_01M5H5HCBMBZGJ357PGT0CYX3J",
    "ero": "ero_01M5H5HAQKTAM4QNSA6XRERW1D",
    "props": [
      {
        "name": "mode",
        "kind": "enum",
        "values": [
          "static",
          "selectable",
          "removable"
        ],
        "default": "static",
        "description": "static: a word on a thing; selectable: a filter a person presses on and off (selected); removable: the word with a button that takes the tag away (the event remove)."
      },
      {
        "name": "selected",
        "kind": "boolean",
        "default": false,
        "description": "The filter is pressed (mode selectable); spoken as aria-pressed."
      },
      {
        "name": "size",
        "kind": "enum",
        "values": [
          "small",
          "medium"
        ],
        "default": "medium",
        "description": "The height of the tag."
      },
      {
        "name": "intent",
        "kind": "enum",
        "values": [
          "neutral",
          "info",
          "success",
          "warning",
          "danger"
        ],
        "default": "neutral",
        "description": "The role the tag takes its colours from (E1: the status roles, no free colour scale)."
      },
      {
        "name": "disabled",
        "kind": "boolean",
        "default": false,
        "description": "Cannot be pressed or removed; spoken as aria-disabled."
      }
    ],
    "states": [
      "rest",
      "hover",
      "focus",
      "disabled"
    ],
    "slots": [
