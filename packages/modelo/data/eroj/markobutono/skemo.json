{
  "ero": {
    "id": "ero_01M4WPZVP7R6HPEMAQ4EJKH3MT",
    "name": "markobutono",
    "skemo": "ske_01M4WPZW25ZEQ8AEGHGBKVC4KB",
    "description": "A checkbox: marks one option as yes or no inside a form; it applies when the form is sent. Its label names the option and always shows; it can show an error."
  },
  "skemo": {
    "id": "ske_01M4WPZW25ZEQ8AEGHGBKVC4KB",
    "ero": "ero_01M4WPZVP7R6HPEMAQ4EJKH3MT",
    "props": [
      {
        "name": "checked",
        "kind": "boolean",
        "default": false,
        "description": "The option is ticked: the box is filled and shows the check mark. A prop, not a state (E2): it holds the answer, the states say how the checkbox is touched."
      },
      {
        "name": "required",
        "kind": "boolean",
        "default": false,
        "description": "Must be ticked before the form is sent (terms accepted); marked visibly and audibly (Regulo required-marked)."
      },
      {
        "name": "invalid",
        "kind": "boolean",
        "default": false,
        "description": "The answer is wrong, a required box left empty; true whenever the slot error is filled (constraint)."
      },
      {
        "name": "size",
        "kind": "enum",
        "values": [
          "small",
          "medium",
          "large"
        ],
        "default": "medium",
        "description": "Box, check mark and label on the scale of the kampo: the check mark takes size.icon.*, the box is the mark plus its border."
      },
      {
        "name": "disabled",
        "kind": "boolean",
        "default": false,
        "description": "Not available; skipped by the keyboard, the answer cannot be changed."
      },
      {
        "name": "loading",
        "kind": "boolean",
        "default": false,
        "description": "Spec 029 ②b-1 M-5: the application loads or checks (a value saved, a list fetched, a file examined): the field says so (aria-busy, described by a11y.texts loading) and shows the turning spinner; it stays operable."
      },
      {
        "name": "name",
        "kind": "string",
        "description": "The name in the form; without effect in a design tool, like type on the butono."
      },
      {
        "name": "label",
        "kind": "string",
        "shown": true,
        "description": "The visible label written as an attribute (Spec 029 ②b-1b, Nachlese 12): <fm-markobutono label=\"E-Mail\"> shows it where the label slot's text would stand and names the control by it, so the simplest way to write the field is labelled; the slot's text wins where both are given."
      },
      {
        "name": "intent",
        "kind": "enum",
        "values": [
          "neutral",
          "success",
          "warning",
          "danger"
        ],
        "default": "neutral",
        "description": "Spec 029 ②b-1b M-2: the status of the field, as avizo and insigno name it. warning and success show their message (slot message) and the border of their status; danger is what invalid says – invalid stays its short form, and a filled error slot shows it too."
      },
      {
        "name": "message-position",
        "kind": "enum",
        "values": [
          "below",
          "joined"
        ],
        "default": "below",
        "description": "Spec 029 ②b-1b M-2: where the message and the error stand – below the field with the space of the field, or joined to it without that space. Never only in a tooltip: the message must be seen (error-not-color-only, error-says-what-to-do)."
      }
    ],
    "states": [
      "rest",
      "hover",
      "focus",
      "disabled",
      "invalid",
      "warning",
      "success"
    ],
    "slots": [
      {
        "name": "label",
        "default": true,
        "text": true,
        "beside": true
      },
      {
        "name": "error",
        "text": true,
        "beside": true
      },
      {
        "name": "message",
        "text": true,
        "beside": true
      },
      {
        "name": "disabled-reason",
        "text": true
      }
    ],
    "parts": {
      "label": {
        "color": {
          "by": [
            "state"
          ]
        },
        "typography": {
          "by": [
            "size"
          ]
        }
      },
      "required-mark": {
        "color": {
          "fixed": "color.status.danger.text"
        }
      },
      "error": {
        "color": {
          "fixed": "color.status.danger.text"
        },
        "typography": {
          "fixed": "typography.caption"
        }
      },
      "surface": {
        "fill": {
          "by": [
            "checked",
            "state"
          ]
        }
      },
      "border": {
        "color": {
          "by": [
            "state"
          ]
        },
        "width": {
          "fixed": "border.width.default"
        }
      },
      "box": {
        "gap": {
          "fixed": "spacing.small"
        },
        "radius": {
          "fixed": "radius.role.control"
        }
      },
      "indicator": {
        "color": {
          "by": [
            "checked"
          ]
        },
        "size": {
          "by": [
            "size"
          ]
        }
      },
      "focus-ring": {
        "ring": {
          "fixed": "focus.ring"
        },
        "offset": {
          "fixed": "focus.offset"
        },
        "color": {
          "fixed": "color.focus.inner"
        }
      },
      "motion": {
        "duration": {
          "fixed": "motion.duration.fast"
        },
        "easing": {
          "fixed": "motion.easing.standard"
        }
      },
      "spinner": {
        "size": {
          "fixed": "size.icon.small"
        },
        "color": {
          "fixed": "color.text.muted"
        },
        "inline-padding": {
          "fixed": "spacing.small"
        }
      },
      "message": {
        "color": {
          "by": [
            "state"
          ]
        },
        "typography": {
          "fixed": "typography.caption"
        }
      }
    },
    "trailing": [
      "spinner"
    ],
    "trailingAfter": "label",
    "bindings": [
      {
        "part": "label",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.text.default"
      },
      {
        "part": "label",
        "property": "color",
        "when": {
          "state": "disabled"
        },
        "token": "color.text.disabled"
      },
      {
        "part": "label",
        "property": "typography",
        "when": {
          "size": "small"
        },
        "token": "typography.label.2"
      },
      {
        "part": "label",
        "property": "typography",
        "when": {
          "size": "medium"
        },
        "token": "typography.label.1"
      },
      {
        "part": "label",
        "property": "typography",
        "when": {
          "size": "large"
        },
        "token": "typography.label.1"
      },
      {
        "part": "surface",
        "property": "fill",
        "when": {
          "checked": "true",
          "state": "rest"
        },
        "token": "color.action.primary.rest"
      },
      {
        "part": "surface",
        "property": "fill",
        "when": {
          "checked": "true",
          "state": "hover"
        },
        "token": "color.action.primary.hover"
      },
      {
        "part": "surface",
        "property": "fill",
        "when": {
          "checked": "true",
          "state": "disabled"
        },
        "token": "color.action.primary.disabled"
      },
      {
        "part": "surface",
        "property": "fill",
        "when": {
          "checked": "false",
          "state": "rest"
        },
        "token": "color.background.default"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.border.strong"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "disabled"
        },
        "token": "color.border.disabled"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "invalid"
        },
        "token": "color.status.danger.border"
      },
      {
        "part": "indicator",
        "property": "color",
        "when": {
          "checked": "true"
        },
        "token": "color.action.primary.text"
      },
      {
        "part": "indicator",
        "property": "color",
        "when": {
          "checked": "false"
        },
        "token": "none"
      },
      {
        "part": "indicator",
        "property": "size",
        "when": {
          "size": "small"
        },
        "token": "size.icon.small"
      },
      {
        "part": "indicator",
        "property": "size",
        "when": {
          "size": "medium"
        },
        "token": "size.icon.medium"
      },
      {
        "part": "indicator",
        "property": "size",
        "when": {
          "size": "large"
        },
        "token": "size.icon.large"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "warning"
        },
        "token": "color.status.warning.border"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "success"
        },
        "token": "color.status.success.border"
      },
      {
        "part": "message",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.text.muted"
      },
      {
        "part": "message",
        "property": "color",
        "when": {
          "state": "warning"
        },
        "token": "color.status.warning.text"
      },
      {
        "part": "message",
        "property": "color",
        "when": {
          "state": "success"
        },
        "token": "color.status.success.text"
      }
    ],
    "a11y": {
      "role": "checkbox",
      "name": [
        "slot:label",
        "prop:label"
      ],
      "description": [
        "slot:error",
        "slot:message",
        "slot:disabled-reason"
      ],
      "states": {
        "checked": [
          "aria-checked"
        ],
        "required": [
          "aria-required"
        ],
        "invalid": [
          "aria-invalid"
        ],
        "disabled": [
          "aria-disabled"
        ],
        "loading": [
          "aria-busy"
        ]
      },
      "keys": [
        "Space"
      ],
      "texts": {
        "required": {
          "de": "erforderlich",
          "en": "required"
        },
        "loading": {
          "de": "lädt",
          "en": "loading"
        }
      }
    },
    "events": [
      {
        "name": "input",
        "description": "The box is turned on or off, by pointer, Space or a click on the label."
      },
      {
        "name": "change",
        "description": "The box was turned, as a native checkbox says it."
      }
    ],
    "constraints": [
      {
        "when": {
          "slot:error": "filled"
        },
        "allowed": {
          "invalid": [
            "true"
          ]
        },
        "kialo": "An error text without the error state is a contradiction a screen reader cannot resolve: it reads a fault on a field that says it is fine."
      },
      {
        "when": {
          "slot:disabled-reason": "filled"
        },
        "allowed": {
          "disabled": [
            "true"
          ]
        },
        "kialo": "A reason without disabled is a contradiction, because it says why something is blocked that is not."
      },
      {
        "when": {
          "slot:message": "filled"
        },
        "allowed": {
          "intent": [
            "success",
            "warning"
          ]
        },
        "kialo": "A message without a warning or a success has no status to say, because an error stands in the slot error and a hint in help."
      },
      {
        "when": {
          "invalid": "true"
        },
        "allowed": {
          "intent": [
            "neutral",
            "danger"
          ]
        },
        "kialo": "invalid is the short form of danger, because a field is wrong or it is not; with a warning or a success it would say two things at once."
      }
    ],
    "goals": [
      {
        "goal": "agree",
        "keywords": {
          "en": [
            "accept",
            "agree",
            "terms",
            "consent"
          ],
          "de": [
            "akzeptieren",
            "zustimmen",
            "agb",
            "einwilligen"
          ]
        },
        "props": {
          "required": true
        },
        "regulo": "required-marked"
      },
      {
        "goal": "opt-in",
        "keywords": {
          "en": [
            "newsletter",
            "remember",
            "subscribe"
          ],
          "de": [
            "newsletter",
            "merken",
            "abonnieren"
          ]
        },
        "props": {},
        "regulo": "field-label-visible"
      }
    ]
  }
}
