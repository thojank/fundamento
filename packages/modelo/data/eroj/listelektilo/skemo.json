{
  "ero": {
    "id": "ero_01M5H5HB465KSVH93E7B32E7YE",
    "name": "listelektilo",
    "skemo": "ske_01M5H5HCR9NKF99T4FP6VKWNH4",
    "description": "A styled select-only list: chooses one option from a list whose options carry an icon or a description. The native select stays the elektilo's; this list is for options that need more than a word."
  },
  "skemo": {
    "id": "ske_01M5H5HCR9NKF99T4FP6VKWNH4",
    "ero": "ero_01M5H5HB465KSVH93E7B32E7YE",
    "props": [
      {
        "name": "value",
        "kind": "string",
        "description": "The value of the chosen option (the entry whose value equals it is selected)."
      },
      {
        "name": "placeholder",
        "kind": "string",
        "description": "The prompt shown while nothing is chosen (Regulo placeholder-is-example: an example, never the label)."
      },
      {
        "name": "required",
        "kind": "boolean",
        "default": false,
        "description": "A choice must be made; marked visibly and audibly (Regulo required-marked)."
      },
      {
        "name": "disabled",
        "kind": "boolean",
        "default": false,
        "description": "Cannot be used: the list does not open; skipped by the keyboard."
      },
      {
        "name": "loading",
        "kind": "boolean",
        "default": false,
        "description": "Spec 029 ②b-1 M-5: the application loads or checks (a value saved, a list fetched, a file examined): the field says so (aria-busy, described by a11y.texts loading) and shows the turning spinner; it stays operable."
      },
      {
        "name": "readonly",
        "kind": "boolean",
        "default": false,
        "description": "Can be read and focused, not changed: the list does not open."
      },
      {
        "name": "invalid",
        "kind": "boolean",
        "default": false,
        "description": "The choice is wrong; the error slot says what to do."
      },
      {
        "name": "expanded",
        "kind": "boolean",
        "default": false,
        "description": "The list is open. The element sets it while the list shows; set by the application it opens the list."
      },
      {
        "name": "name",
        "kind": "string",
        "description": "The name under which the form sends the choice."
      },
      {
        "name": "clearable",
        "kind": "boolean",
        "default": false,
        "description": "Spec 029 ②b-1 M-6: a clear button in the field, shown while it has a value and is neither disabled nor read-only, named „{label} leeren“; a press empties the value and returns the focus to the field."
      },
      {
        "name": "label",
        "kind": "string",
        "shown": true,
        "description": "The visible label written as an attribute (Spec 029 ②b-1b, Nachlese 12): <fm-listelektilo label=\"E-Mail\"> shows it where the label slot's text would stand and names the control by it, so the simplest way to write the field is labelled; the slot's text wins where both are given."
      },
      {
        "name": "intent",
        "kind": "enum",
        "values": [
          "neutral",
          "success",
          "warning",
          "danger"
        ],
        "default": "neutral",
        "description": "Spec 029 ②b-1b M-2: the status of the field, as avizo and insigno name it. warning and success show their message (slot message) and the border of their status; danger is what invalid says – invalid stays its short form, and a filled error slot shows it too."
      },
      {
        "name": "message-position",
        "kind": "enum",
        "values": [
          "below",
          "joined"
        ],
        "default": "below",
        "description": "Spec 029 ②b-1b M-2: where the message and the error stand – below the field with the space of the field, or joined to it without that space. Never only in a tooltip: the message must be seen (error-not-color-only, error-says-what-to-do)."
      }
    ],
    "states": [
      "rest",
      "hover",
      "focus",
      "disabled",
      "readonly",
      "invalid",
      "warning",
      "success"
    ],
    "slots": [
      {
        "name": "label",
        "default": true,
        "text": true
      },
      {
        "name": "options",
        "text": true,
        "entry": {
          "key": "selected",
          "equals": "value",
          "active": "active"
        }
      },
      {
        "name": "help",
        "text": true
      },
      {
        "name": "error",
        "text": true
      },
      {
        "name": "message",
        "text": true,
        "beside": true
      },
      {
        "name": "disabled-reason",
        "text": true
      }
    ],
    "parts": {
      "label": {
        "color": {
          "by": [
            "state"
          ]
        },
        "typography": {
          "fixed": "typography.label.1"
        }
      },
      "required-mark": {
        "color": {
          "fixed": "color.status.danger.text"
        }
      },
      "surface": {
        "fill": {
          "by": [
            "state"
          ]
        }
      },
      "border": {
        "color": {
          "by": [
            "state"
          ]
        },
        "width": {
          "fixed": "border.width.default"
        }
      },
      "text": {
        "color": {
          "by": [
            "state"
          ]
        },
        "typography": {
          "fixed": "typography.body.1"
        }
      },
      "placeholder": {
        "color": {
          "fixed": "color.text.subtle"
        }
      },
      "indicator": {
        "color": {
          "fixed": "color.text.muted"
        },
        "size": {
          "fixed": "size.icon.medium"
        }
      },
      "listbox": {
        "fill": {
          "fixed": "color.background.raised"
        },
        "radius": {
          "fixed": "radius.role.surface"
        },
        "shadow": {
          "fixed": "elevation.shadow.overlay"
        },
        "layer": {
          "fixed": "elevation.layer.overlay"
        },
        "width": {
          "fixed": "size.container.small"
        },
        "height": {
          "by": [
            "expanded"
          ]
        }
      },
      "item": {
        "color": {
          "by": [
            "selected"
          ]
        },
        "fill": {
          "by": [
            "active"
          ]
        },
        "typography": {
          "fixed": "typography.label.1"
        },
        "height": {
          "fixed": "size.target.min"
        },
        "inline-padding": {
          "fixed": "spacing.medium"
        },
        "radius": {
          "fixed": "radius.role.control"
        }
      },
      "icon": {
        "size": {
          "fixed": "size.icon.medium"
        }
      },
      "description": {
        "color": {
          "fixed": "color.text.muted"
        },
        "typography": {
          "fixed": "typography.caption"
        }
      },
      "help": {
        "color": {
          "fixed": "color.text.muted"
        },
        "typography": {
          "fixed": "typography.caption"
        }
      },
      "error": {
        "color": {
          "fixed": "color.status.danger.text"
        },
        "typography": {
          "fixed": "typography.caption"
        }
      },
      "focus-ring": {
        "ring": {
          "fixed": "focus.ring"
        },
        "offset": {
          "fixed": "focus.offset"
        },
        "color": {
          "fixed": "color.focus.inner"
        }
      },
      "box": {
        "height": {
          "fixed": "size.control.medium"
        },
        "inline-padding": {
          "fixed": "spacing.medium"
        },
        "gap": {
          "fixed": "spacing.small"
        },
        "radius": {
          "fixed": "radius.role.control"
        }
      },
      "motion": {
        "duration": {
          "fixed": "motion.duration.fast"
        },
        "easing": {
          "fixed": "motion.easing.standard"
        }
      },
      "spinner": {
        "size": {
          "fixed": "size.icon.small"
        },
        "color": {
          "fixed": "color.text.muted"
        },
        "inline-padding": {
          "fixed": "spacing.small"
        }
      },
      "clear": {
        "size": {
          "fixed": "size.icon.medium"
        },
        "width": {
          "fixed": "size.target.min"
        }
      },
      "message": {
        "color": {
          "by": [
            "state"
          ]
        },
        "typography": {
          "fixed": "typography.caption"
        }
      }
    },
    "trailing": [
      "spinner",
      "clear",
      "indicator"
    ],
    "bindings": [
      {
        "part": "label",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.text.default"
      },
      {
        "part": "label",
        "property": "color",
        "when": {
          "state": "disabled"
        },
        "token": "color.text.disabled"
      },
      {
        "part": "surface",
        "property": "fill",
        "when": {
          "state": "rest"
        },
        "token": "color.background.default"
      },
      {
        "part": "surface",
        "property": "fill",
        "when": {
          "state": "disabled"
        },
        "token": "color.background.sunken"
      },
      {
        "part": "surface",
        "property": "fill",
        "when": {
          "state": "readonly"
        },
        "token": "color.background.default"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.border.default"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "hover"
        },
        "token": "color.border.strong"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "focus"
        },
        "token": "color.border.strong"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "disabled"
        },
        "token": "color.border.disabled"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "readonly"
        },
        "token": "color.border.default"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "invalid"
        },
        "token": "color.status.danger.border"
      },
      {
        "part": "text",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.text.default"
      },
      {
        "part": "text",
        "property": "color",
        "when": {
          "state": "disabled"
        },
        "token": "color.text.disabled"
      },
      {
        "part": "listbox",
        "property": "height",
        "when": {
          "expanded": "false"
        },
        "token": "none"
      },
      {
        "part": "listbox",
        "property": "height",
        "when": {
          "expanded": "true"
        },
        "token": "size.container.small"
      },
      {
        "part": "item",
        "property": "color",
        "when": {
          "selected": "true"
        },
        "token": "color.text.default"
      },
      {
        "part": "item",
        "property": "color",
        "when": {
          "selected": "false"
        },
        "token": "color.text.subtle"
      },
      {
        "part": "item",
        "property": "fill",
        "when": {
          "active": "true"
        },
        "token": "color.background.sunken"
      },
      {
        "part": "item",
        "property": "fill",
        "when": {
          "active": "false"
        },
        "token": "color.background.raised"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "warning"
        },
        "token": "color.status.warning.border"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "success"
        },
        "token": "color.status.success.border"
      },
      {
        "part": "message",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.text.muted"
      },
      {
        "part": "message",
        "property": "color",
        "when": {
          "state": "warning"
        },
        "token": "color.status.warning.text"
      },
      {
        "part": "message",
        "property": "color",
        "when": {
          "state": "success"
        },
        "token": "color.status.success.text"
      }
    ],
    "a11y": {
      "role": "combobox",
      "name": [
        "slot:label",
        "prop:label"
      ],
      "description": [
        "slot:help",
        "slot:error",
        "slot:message",
        "slot:disabled-reason"
      ],
      "states": {
        "selected": [
          "aria-selected"
        ],
        "required": [
          "aria-required"
        ],
        "invalid": [
          "aria-invalid"
        ],
        "disabled": [
          "aria-disabled"
        ],
        "readonly": [
          "aria-readonly"
        ],
        "expanded": [
          "aria-expanded"
        ],
        "loading": [
          "aria-busy"
        ]
      },
      "keys": [
        "ArrowUp",
        "ArrowDown",
        "Home",
        "End",
        "Enter",
        "Space",
        "Escape"
      ],
      "texts": {
        "required": {
          "de": "erforderlich",
          "en": "required"
        },
        "loading": {
          "de": "lädt",
          "en": "loading"
        },
        "clear-name": {
          "de": "{label} leeren",
          "en": "Clear {label}"
        }
      }
    },
    "events": [
      {
        "name": "change",
        "description": "An option was chosen, by a click, Enter, Space or a typed letter."
      }
    ],
    "constraints": [
      {
        "when": {
          "slot:error": "filled"
        },
        "allowed": {
          "invalid": [
            "true"
          ]
        },
        "kialo": "An error text without the error state is a contradiction a screen reader cannot resolve, because it reads a fault on a list that says it is fine."
      },
      {
        "when": {
          "disabled": "true"
        },
        "allowed": {
          "readonly": [
            "false"
          ]
        },
        "kialo": "Two reasons why one cannot choose are one too many, because disabled wins."
      },
      {
        "when": {
          "slot:disabled-reason": "filled"
        },
        "allowed": {
          "disabled": [
            "true"
          ]
        },
        "kialo": "A reason without disabled is a contradiction, because it says why something is blocked that is not."
      },
      {
        "when": {
          "slot:message": "filled"
        },
        "allowed": {
          "intent": [
            "success",
            "warning"
          ]
        },
        "kialo": "A message without a warning or a success has no status to say, because an error stands in the slot error and a hint in help."
      },
      {
        "when": {
          "invalid": "true"
        },
        "allowed": {
          "intent": [
            "neutral",
            "danger"
          ]
        },
        "kialo": "invalid is the short form of danger, because a field is wrong or it is not; with a warning or a success it would say two things at once."
      }
    ],
    "goals": [
      {
        "goal": "styled-choice",
        "keywords": {
          "en": [
            "styled-options",
            "option-icons",
            "option-descriptions",
            "rich-options",
            "icons-and-descriptions"
          ],
          "de": [
            "symbolen",
            "symbole",
            "beschreibung",
            "beschreibungen",
            "gestaltete-liste"
          ]
        },
        "props": {},
        "regulo": "field-label-visible"
      }
    ]
  }
}
