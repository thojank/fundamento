{
  "$schema": "../../../schema/modelo.schema.json#/$defs/UzoFile",
  "uzo": {
    "id": "uzo_01M5H5HEAT1KZ7BMRF5J3QTMGM",
    "ero": "ero_01M5H5HB465KSVH93E7B32E7YE",
    "skemo": "ske_01M5H5HCR9NKF99T4FP6VKWNH4",
    "purpose": "Chooses one option from a styled list when options need an icon or a description.",
    "instead": [
      {
        "goal": "plain-options",
        "keywords": {
          "en": [
            "plain",
            "native",
            "simple-options"
          ],
          "de": [
            "schlicht",
            "nativ",
            "einfache-optionen"
          ]
        },
        "ero": "elektilo",
        "kialo": "Options that are words alone are the elektilo's, because the native list is the easiest to use on every device."
      }
    ],
    "boundary": [
      {
        "case": "search-in-list",
        "action": "use-instead",
        "keywords": {
          "en": [
            "search-in-list",
            "typeahead"
          ],
          "de": [
            "suchen",
            "durchsuchbar"
          ]
        },
        "kialo": "A list a person searches while typing is the kompletigilo, because the field takes the letters; this list takes a letter only to jump.",
        "ero": "kompletigilo"
      }
    ],
    "composes": {
      "containers": [
        {
          "name": "form",
          "kialo": "A list without a form has no sender, because the choice is only sent with the form."
        },
        {
          "name": "dialog",
          "kialo": "A dialog may ask for a choice before it ends, because the decision it ends in may need one."
        }
      ],
      "with": [
        {
          "ero": "ikono",
          "kialo": "An option carries its icon before its word, because the icon tells options apart faster than words alone."
        },
        {
          "ero": "kampo",
          "kialo": "A styled list stands among the fields of a form, because a choice is one entry of many."
        }
      ],
      "never": [
        {
          "ero": "butono",
          "kialo": "A list stands in no slot of a button, because a button is one target with one name."
        }
      ],
      "spacing": {
        "owner": "container",
        "regulo": "spacing-owned-by-container"
      }
    },
    "slots": {
      "label": {
        "accepts": [
          "text"
        ],
        "required": true,
        "max": 1,
        "nesting": 0
      },
      "options": {
        "accepts": [
          "text"
        ],
        "required": true,
        "min": 2,
        "nesting": 0
      },
      "help": {
        "accepts": [
          "text"
        ],
        "max": 1,
        "nesting": 0
      },
      "error": {
        "accepts": [
          "text"
        ],
        "max": 1,
        "nesting": 0
      },
      "message": {
        "accepts": [
          "text"
        ],
        "max": 1,
        "nesting": 0
      }
    },
    "layout": {
      "size": "container",
      "wrap": "never"
    },
    "content": [
      {
        "regulo": "field-label-names-the-datum",
        "fixed": false,
        "check": {
          "kind": "not-words",
          "words": {
            "de": [
              "wählen",
              "auswählen",
              "aussuchen"
            ],
            "en": [
              "choose",
              "select",
              "pick"
            ]
          }
        }
      },
      {
        "regulo": "error-says-what-to-do",
        "fixed": true,
        "of": "slot:error",
        "check": {
          "kind": "min-words",
          "count": 3
        }
      },
      {
        "regulo": "help-is-one-sentence",
        "fixed": false,
        "of": "slot:help",
        "check": {
          "kind": "max-sentences",
          "count": 1
        }
      }
    ]
  }
}
