{
  "ero": {
    "id": "ero_01M58G3CNE0MHGRKAJ23VNJ6P9",
    "name": "avataro",
    "skemo": "ske_01M58G3D1F5ABHWV5AGSE09QBV",
    "description": "An avatar: represents a person or a thing with a picture or, where there is none or it does not load, with the initials of its name. Named by that name, or hidden where the name stands beside it; never a colour worked out from the name."
  },
  "skemo": {
    "id": "ske_01M58G3D1F5ABHWV5AGSE09QBV",
    "ero": "ero_01M58G3CNE0MHGRKAJ23VNJ6P9",
    "props": [
      {
        "name": "name",
        "kind": "string",
        "required": true,
        "description": "The name of the person or thing: the accessible name of the picture and the source of the initials (at most two, the first letter of the first and of the last word, grapheme by grapheme)."
      },
      {
        "name": "picture",
        "kind": "string",
        "description": "The address of the picture (the Web Celo renders it as the image's src, as `to` of the ligilo is its href); without it, and while it does not load, the initials stand."
      },
      {
        "name": "size",
        "kind": "enum",
        "values": [
          "x-small",
          "small",
          "medium",
          "large",
          "x-large"
        ],
        "default": "medium",
        "description": "The size of the circle: small and medium on the icon scale (beside a line of text), large on the control scale (a profile header), which density changes. Spec 029 ②a (A-avataro-2): x-small for dense lists, x-large for the head of a profile."
      },
      {
        "name": "decorative",
        "kind": "boolean",
        "default": false,
        "description": "True where the name stands right beside the avatar: then the picture is hidden from assistive technology, so the name is not heard twice."
      },
      {
        "name": "corner",
        "kind": "enum",
        "values": [
          "round",
          "soft",
          "square"
        ],
        "default": "round",
        "description": "Spec 029 ②a (A-avataro-1): the shape – round for a person, as before; soft and square for a team or a thing."
      }
    ],
    "states": [
      "rest"
    ],
    "slots": [],
    "parts": {
      "image": {
        "radius": {
          "by": [
            "corner"
          ]
        }
      },
      "initials": {
