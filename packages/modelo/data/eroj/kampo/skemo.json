{
  "ero": {
    "id": "ero_01M4S1ZQ3PW2DRK02VPJ6JE5NF",
    "name": "kampo",
    "skemo": "ske_01M4S1ZQFKVZX7X0A8W94SRGCE",
    "description": "A text field: takes one line of text from a person. It always shows its label, and can show help and an error. A number may show step buttons, a search a clear button, a time is the platform's own."
  },
  "skemo": {
    "id": "ske_01M4S1ZQFKVZX7X0A8W94SRGCE",
    "ero": "ero_01M4S1ZQ3PW2DRK02VPJ6JE5NF",
    "props": [
      {
        "name": "kind",
        "kind": "enum",
        "values": [
          "text",
          "email",
          "tel",
          "url",
          "search",
          "password",
          "number",
          "date",
          "time"
        ],
        "default": "text",
        "description": "What kind of text is expected; changes the keyboard on touch and the input aids, never the look. password hides what is typed; number takes a whole number (a text input with a numeric keyboard, no wheel or arrows unless stepper says so); date and time open the platform's own dialogs; search clears with a button and Escape."
      },
      {
        "name": "value",
        "kind": "string",
        "description": "The current text."
      },
      {
        "name": "placeholder",
        "kind": "string",
        "description": "An example in the empty field; never the label (Regulo placeholder-not-label)."
      },
      {
        "name": "required",
        "kind": "boolean",
        "default": false,
        "description": "Must be filled in; marked visibly and audibly (Regulo required-marked)."
      },
      {
        "name": "disabled",
        "kind": "boolean",
        "default": false,
        "description": "Not available; skipped by the keyboard."
      },
      {
        "name": "readonly",
        "kind": "boolean",
        "default": false,
        "description": "Readable and focusable, not changeable."
      },
      {
        "name": "invalid",
        "kind": "boolean",
        "default": false,
        "description": "The value is wrong; true whenever the slot error is filled (constraint)."
      },
      {
        "name": "size",
        "kind": "enum",
        "values": [
          "small",
          "medium",
          "large"
        ],
        "default": "medium",
        "description": "Height of the input line on the scale of the butono (size.control.*), so field and button stand level in one row."
      },
      {
        "name": "name",
        "kind": "string",
        "description": "The name in the form; without effect in a design tool, like type on the butono."
      },
      {
        "name": "min",
        "kind": "string",
        "description": "The lowest whole number or earliest date allowed (constraint: only with kind number or date)."
      },
      {
        "name": "max",
        "kind": "string",
        "description": "The highest whole number or latest date allowed (constraint: only with kind number or date)."
      },
      {
        "name": "autocomplete",
        "kind": "string",
        "description": "What the platform may fill in, in the platform's words: current-password or new-password for a password, email for an e-mail."
      },
      {
        "name": "stepper",
        "kind": "boolean",
        "default": false,
        "description": "Step buttons beside a number (constraint: only with kind number): Verringern and Erhöhen as composed butono with the ikono subtract and add, stepping by step within min and max, as the arrow keys do."
      },
      {
        "name": "step",
        "kind": "string",
        "description": "How far one step button or one arrow key moves a number (constraint: only with kind number); 1 without it."
      }
    ],
    "states": [
      "rest",
      "hover",
      "focus",
      "disabled",
      "readonly",
      "invalid"
    ],
    "slots": [
      {
        "name": "label",
        "default": true,
        "text": true
      },
      {
        "name": "help",
        "text": true
      },
      {
        "name": "error",
        "text": true
      }
    ],
    "parts": {
      "label": {
        "color": {
          "by": [
            "state"
          ]
        },
        "typography": {
          "by": [
            "size"
          ]
        }
      },
      "required-mark": {
        "color": {
          "fixed": "color.status.danger.text"
        }
      },
      "surface": {
        "fill": {
          "by": [
            "state"
          ]
        }
      },
      "border": {
        "color": {
          "by": [
            "state"
          ]
        },
        "width": {
          "fixed": "border.width.default"
        }
      },
      "text": {
        "color": {
          "by": [
            "state"
          ]
        },
        "typography": {
          "by": [
            "size"
          ]
        }
      },
      "placeholder": {
        "color": {
          "fixed": "color.text.subtle"
        }
      },
      "help": {
        "color": {
          "fixed": "color.text.muted"
        },
        "typography": {
          "fixed": "typography.caption"
        }
      },
      "error": {
        "color": {
          "fixed": "color.status.danger.text"
        },
        "typography": {
          "fixed": "typography.caption"
        }
      },
      "focus-ring": {
        "ring": {
          "fixed": "focus.ring"
        },
        "offset": {
          "fixed": "focus.offset"
        },
        "color": {
          "fixed": "color.focus.inner"
        }
      },
      "box": {
        "height": {
          "by": [
            "size"
          ]
        },
        "inline-padding": {
          "by": [
            "size"
          ]
        },
        "gap": {
          "fixed": "spacing.small"
        },
        "radius": {
          "fixed": "radius.role.control"
        }
      },
      "motion": {
        "duration": {
          "fixed": "motion.duration.fast"
        },
        "easing": {
          "fixed": "motion.easing.standard"
        }
      },
      "decrement": {
        "size": {
          "by": [
            "size"
          ]
        }
      },
      "increment": {
        "size": {
          "by": [
            "size"
          ]
        }
      },
      "clear": {
        "size": {
          "fixed": "size.control.small"
        }
      }
    },
    "bindings": [
      {
        "part": "label",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.text.default"
      },
      {
        "part": "label",
        "property": "color",
        "when": {
          "state": "disabled"
        },
        "token": "color.text.disabled"
      },
      {
        "part": "label",
        "property": "typography",
        "when": {
          "size": "small"
        },
        "token": "typography.label.2"
      },
      {
        "part": "label",
        "property": "typography",
        "when": {
          "size": "medium"
        },
        "token": "typography.label.1"
      },
      {
        "part": "label",
        "property": "typography",
        "when": {
          "size": "large"
        },
        "token": "typography.label.1"
      },
      {
        "part": "surface",
        "property": "fill",
        "when": {
          "state": "rest"
        },
        "token": "color.background.default"
      },
      {
        "part": "surface",
        "property": "fill",
        "when": {
          "state": "disabled"
        },
        "token": "color.background.sunken"
      },
      {
        "part": "surface",
        "property": "fill",
        "when": {
          "state": "readonly"
        },
        "token": "color.background.sunken"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.border.default"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "hover"
        },
        "token": "color.border.strong"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "focus"
        },
        "token": "color.border.strong"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "disabled"
        },
        "token": "color.border.disabled"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
          "state": "readonly"
        },
        "token": "color.border.default"
      },
      {
        "part": "border",
        "property": "color",
        "when": {
