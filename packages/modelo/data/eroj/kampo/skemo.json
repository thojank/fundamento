    "a11y": {
      "role": "textbox",
      "name": [
        "slot:label"
      ],
      "description": [
        "slot:help",
        "slot:error"
      ],
      "states": {
        "required": [
          "aria-required"
        ],
        "invalid": [
          "aria-invalid"
        ],
        "disabled": [
          "aria-disabled"
        ],
        "readonly": [
          "aria-readonly"
        ]
      },
      "keys": [
        "Enter",
        "ArrowUp",
        "ArrowDown",
        "Escape"
      ],
      "texts": {
        "required": {
          "de": "erforderlich",
          "en": "required"
        },
        "decrement-name": {
          "de": "Verringern",
          "en": "Decrease"
        },
        "increment-name": {
          "de": "Erhöhen",
          "en": "Increase"
        },
        "clear-name": {
          "de": "Suche leeren",
          "en": "Clear search"
        }
      }
    },
    "events": [
      {
        "name": "input",
        "description": "The text changes while a person types, steps or clears."
      },
      {
        "name": "change",
        "description": "The field is left with a text other than the one it was entered with, or a step button was pressed."
      }
    ],
    "constraints": [
      {
        "when": {
          "slot:error": "filled"
        },
        "allowed": {
          "invalid": [
            "true"
          ]
        },
        "kialo": "An error text without the error state is a contradiction a screen reader cannot resolve: it reads a fault on a field that says it is fine."
      },
      {
        "when": {
          "disabled": "true"
        },
        "allowed": {
          "readonly": [
            "false"
          ]
        },
        "kialo": "Two reasons why one cannot type are one too many; disabled wins."
      },
      {
        "when": {
          "prop:min": "filled"
        },
        "allowed": {
          "kind": [
            "number",
            "date",
            "time"
          ]
        },
        "kialo": "A bound needs a scale; text, an address or a password has none; a time has one, so min says nothing there."
      },
      {
        "when": {
          "prop:max": "filled"
        },
        "allowed": {
          "kind": [
            "number",
            "date",
            "time"
          ]
        },
        "kialo": "A bound needs a scale; text, an address or a password has none; a time has one, so max says nothing there."
      },
      {
        "when": {
          "stepper": "true"
        },
        "allowed": {
          "kind": [
            "number"
          ]
        },
        "kialo": "Step buttons step a number, because only a number has a next and a previous value; on a text they would have nothing to step."
      },
      {
        "when": {
          "prop:step": "filled"
        },
        "allowed": {
          "kind": [
            "number"
          ]
        },
        "kialo": "A step needs a scale, because only a number moves by a step; a text has none."
      }
    ],
    "goals": [
