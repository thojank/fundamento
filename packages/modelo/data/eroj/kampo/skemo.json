        },
        "token": "size.control.small"
      },
      {
        "part": "decrement",
        "property": "size",
        "when": {
          "size": "medium"
        },
        "token": "size.control.medium"
      },
      {
        "part": "decrement",
        "property": "size",
        "when": {
          "size": "large"
        },
        "token": "size.control.large"
      },
      {
        "part": "increment",
        "property": "size",
        "when": {
          "size": "small"
        },
        "token": "size.control.small"
      },
      {
        "part": "increment",
        "property": "size",
        "when": {
          "size": "medium"
        },
        "token": "size.control.medium"
      },
      {
        "part": "increment",
        "property": "size",
        "when": {
          "size": "large"
        },
        "token": "size.control.large"
