        },
        "token": "color.status.danger.border"
      },
      {
        "part": "text",
        "property": "color",
        "when": {
          "state": "rest"
        },
        "token": "color.text.default"
      },
      {
        "part": "text",
        "property": "color",
        "when": {
          "state": "disabled"
        },
        "token": "color.text.disabled"
      },
      {
        "part": "text",
        "property": "typography",
        "when": {
          "size": "small"
        },
        "token": "typography.body.2"
      },
      {
        "part": "text",
        "property": "typography",
        "when": {
          "size": "medium"
        },
        "token": "typography.body.1"
      },
      {
        "part": "text",
        "property": "typography",
        "when": {
          "size": "large"
        },
        "token": "typography.body.1"
      },
      {
        "part": "box",
        "property": "height",
        "when": {
          "size": "small"
        },
        "token": "size.control.small"
      },
      {
        "part": "box",
        "property": "height",
        "when": {
          "size": "medium"
        },
        "token": "size.control.medium"
      },
      {
        "part": "box",
        "property": "height",
        "when": {
          "size": "large"
        },
        "token": "size.control.large"
      },
      {
        "part": "box",
        "property": "inline-padding",
        "when": {
