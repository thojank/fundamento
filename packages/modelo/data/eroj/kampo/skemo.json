        },
        "token": "spacing.small"
      },
      {
        "part": "box",
        "property": "inline-padding",
        "when": {
          "size": "medium"
        },
        "token": "spacing.medium"
      },
      {
        "part": "box",
        "property": "inline-padding",
        "when": {
