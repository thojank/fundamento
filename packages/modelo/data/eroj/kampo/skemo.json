    "name": "kampo",
    "skemo": "ske_01M4S1ZQFKVZX7X0A8W94SRGCE",
    "description": "A text field: takes one line of text from a person. It always shows its label, and can show help and an error."
  },
  "skemo": {
    "id": "ske_01M4S1ZQFKVZX7X0A8W94SRGCE",
    "ero": "ero_01M4S1ZQ3PW2DRK02VPJ6JE5NF",
    "props": [
      {
        "name": "kind",
        "kind": "enum",
        "values": [
          "text",
          "email",
          "tel",
          "url",
          "search"
        ],
        "default": "text",
        "description": "What kind of text is expected; changes the keyboard on touch and the input aids, never the look."
      },
      {
        "name": "value",
        "kind": "string",
        "description": "The current text."
      },
      {
        "name": "placeholder",
        "kind": "string",
        "description": "An example in the empty field; never the label (Regulo placeholder-not-label)."
      },
      {
        "name": "required",
        "kind": "boolean",
        "default": false,
        "description": "Must be filled in; marked visibly and audibly (Regulo required-marked)."
      },
      {
        "name": "disabled",
        "kind": "boolean",
        "default": false,
        "description": "Not available; skipped by the keyboard."
      },
      {
        "name": "readonly",
        "kind": "boolean",
        "default": false,
        "description": "Readable and focusable, not changeable."
      },
      {
        "name": "invalid",
        "kind": "boolean",
        "default": false,
        "description": "The value is wrong; true whenever the slot error is filled (constraint)."
      },
      {
        "name": "size",
        "kind": "enum",
        "values": [
          "small",
          "medium",
          "large"
        ],
        "default": "medium",
        "description": "Height of the input line on the scale of the butono (size.control.*), so field and button stand level in one row."
      },
      {
        "name": "name",
        "kind": "string",
        "description": "The name in the form; without effect in a design tool, like type on the butono."
      }
