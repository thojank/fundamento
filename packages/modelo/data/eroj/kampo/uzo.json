{
  "$schema": "../../../schema/modelo.schema.json#/$defs/UzoFile",
  "uzo": {
    "id": "uzo_01M4S1ZQVJ03HSQDA2SFEKA3DC",
    "ero": "ero_01M4S1ZQ3PW2DRK02VPJ6JE5NF",
    "skemo": "ske_01M4S1ZQFKVZX7X0A8W94SRGCE",
    "purpose": "Takes one line of text from a person: a name, an address, an e-mail, a search term.",
    "instead": [
      {
        "goal": "multi-line",
        "keywords": {
          "en": [
            "comment",
            "description",
            "paragraph",
            "multiline"
          ],
          "de": [
            "kommentar",
            "beschreibung",
            "absatz",
            "mehrzeilig"
          ]
        },
        "ero": "tekstareo",
        "kialo": "Several lines need a field that grows with them, because one line hides what was written; tekstareo covers it."
      },
      {
        "goal": "choose-many",
        "keywords": {
          "en": [
            "select",
            "list",
            "country",
            "language",
            "many"
          ],
          "de": [
            "auswählen",
            "liste",
            "land",
            "sprache",
            "vielen"
          ]
        },
        "ero": "elektilo",
        "kialo": "Many options are a list, because a field takes any text; elektilo covers it."
      },
      {
        "goal": "choose-few",
        "keywords": {
          "en": [
            "choose",
            "pick",
            "option",
            "two",
            "three"
          ],
          "de": [
            "wählen",
            "wähle",
            "option",
            "variante",
            "zwei",
            "drei"
          ]
        },
        "ero": "elekto",
        "kialo": "A few options are chosen, not typed, because a field takes any text; elekto covers it."
      },
      {
        "goal": "toggle",
        "keywords": {
          "en": [
            "toggle",
            "switch"
          ],
          "de": [
            "umschalten",
            "einschalten",
            "ausschalten"
          ]
        },
        "ero": "sxaltilo",
        "kialo": "A setting on or off needs a control that shows its state, because a text would have to be read to know it; sxaltilo when it applies at once (in a form, applied with it: markobutono)."
      },
      {
        "goal": "suggestions",
        "keywords": {
          "en": [
            "autocomplete",
            "typeahead",
            "suggestions"
          ],
          "de": [
            "autocomplete",
            "typeahead",
            "vorschläge",
            "autovervollständigung"
          ]
        },
        "ero": "kompletigilo",
        "kialo": "A field whose values a person types and picks from suggestions is the kompletigilo, because the list shortens while typing; a plain field knows no suggestions."
      }
    ],
    "boundary": [
      {
        "case": "reveal-password",
        "action": "ask-human",
        "keywords": {
          "en": [
            "reveal",
            "unmask",
            "show-password"
          ],
          "de": [
            "einblenden",
            "verbergen",
            "anzeigen"
          ]
        },
        "kialo": "A switch that shows the password is a control of its own, because the field only hides; a person decides whether a product wants it."
      },
      {
        "case": "number-stepper",
        "action": "not-supported",
        "keywords": {
          "en": [
            "stepper",
            "counter"
          ],
          "de": [
            "zähler"
          ]
        },
        "kialo": "Step buttons are a control of their own, because they change the value and the field only shows it."
      },
      {
        "case": "decimal",
        "action": "not-supported",
        "keywords": {
          "en": [
            "decimal",
            "float",
            "fraction"
          ],
          "de": [
            "dezimalzahl",
            "dezimal",
            "kommazahl",
            "nachkommastellen"
          ]
        },
        "kialo": "A fraction is written with a comma or a point, because the separator is a locale; number takes whole numbers only."
      },
      {
        "case": "date-range",
        "action": "ask-human",
        "keywords": {
          "en": [
            "period",
            "range"
          ],
          "de": [
            "zeitraum",
            "datumsbereich"
          ]
        },
        "kialo": "Two dates that depend on each other are an Ero of their own, because the end lies after the start; Fundamento has none yet."
      },
      {
        "case": "file",
        "action": "ask-human",
        "keywords": {
          "en": [
            "file",
            "upload"
          ],
          "de": [
            "datei",
            "hochladen"
          ]
        },
        "kialo": "A file is chosen, not typed, because the value is not text; no such Ero yet, so a person decides."
      },
      {
        "case": "no-visible-label",
        "action": "not-supported",
        "via": {
          "regulo": "field-label-visible"
        },
        "kialo": "A field without a visible label is lost once typing starts, because the placeholder disappears then."
      },
      {
        "case": "icon-in-field",
        "action": "not-supported",
        "kialo": "A prefix or suffix (currency, unit, icon) comes in a later round, because it changes the inline room; until then an icon stands next to the field."
      }
    ],
    "composes": {
      "containers": [
        {
          "name": "form",
          "kialo": "A field without a form has no sender, because the entry is only sent with the form."
        },
        {
          "name": "dialog",
          "kialo": "A dialog may demand an entry before it ends, because the decision it ends in may need a value."
        },
        {
          "name": "search-bar",
          "kialo": "A search is one field with its button, because the term is the whole entry."
        }
      ],
      "with": [
        {
          "ero": "kampo",
          "kialo": "Fields of one form stand stacked, because a person reads a form top down and fills it in that order."
        },
        {
          "ero": "butono",
          "kialo": "The form ends with the button that sends it, because filling it in does nothing by itself; the button stands after the last field, not beside it (a search excepted)."
        }
      ],
      "never": [
        {
          "ero": "butono",
          "kialo": "A field stands in no slot of a button, because a button is one target with one name and the field could not be reached on its own."
        }
      ],
      "spacing": {
        "owner": "container",
        "regulo": "spacing-owned-by-container"
      }
    },
    "slots": {
      "label": {
        "accepts": [
          "text"
        ],
        "required": true,
        "max": 1,
        "nesting": 0
      },
      "help": {
        "accepts": [
          "text"
        ],
        "max": 1,
        "nesting": 0
      },
      "error": {
        "accepts": [
          "text"
        ],
        "max": 1,
        "nesting": 0
      }
    },
    "layout": {
      "size": "container",
      "wrap": "never"
    },
    "content": [
      {
        "regulo": "field-label-names-the-datum",
        "fixed": false,
        "check": {
          "kind": "not-words",
          "words": {
            "de": [
              "eingeben",
              "eintragen",
              "ausfüllen"
            ],
            "en": [
              "enter",
              "type",
              "complete"
            ]
          }
        }
      },
      {
        "regulo": "error-says-what-to-do",
        "fixed": true,
        "of": "slot:error",
        "check": {
          "kind": "min-words",
          "count": 3
        }
      },
      {
        "regulo": "help-is-one-sentence",
        "fixed": false,
        "of": "slot:help",
        "check": {
          "kind": "max-sentences",
          "count": 1
        }
      },
      {
        "regulo": "placeholder-is-example",
        "fixed": false,
        "of": "prop:placeholder",
        "check": {
          "kind": "not-words",
          "words": {
            "de": [
              "hier",
              "eingeben",
              "bitte"
            ],
            "en": [
              "here",
              "enter",
              "please"
            ]
          }
        }
      }
    ]
  }
}
