        ]
      },
      "keys": [
        "ArrowDown",
        "ArrowUp",
        "Home",
        "End",
        "Escape",
        "Enter",
        "Space"
      ],
      "texts": {
        "label-empty": {
          "de": "Weitere Aktionen",
          "en": "More actions"
        }
      }
    },
    "goals": [
