{
  "$schema": "../../../schema/modelo.schema.json#/$defs/UzoFile",
  "uzo": {
    "id": "uzo_01M5GYYDGXAZSS03E95136YPGK",
    "ero": "ero_01M5GYYCPEQ6SKJGPDKMFVZCAQ",
    "skemo": "ske_01M5GYYD31C6C7EN316YWX0FYY",
    "purpose": "Lets a person choose a date or a date range near today, typed or picked from a calendar.",
    "instead": [
      {
        "goal": "birthday",
        "keywords": {
          "en": [
            "birthday",
            "date-of-birth",
            "born"
          ],
          "de": [
            "geburtsdatum",
            "geburtstag",
            "geboren"
          ]
        },
        "ero": "kampo",
        "kialo": "A date far away, like a birthday, is typed, because scrolling through years and months in a calendar takes longer than typing eight digits; the kampo of kind date takes it."
      }
    ],
    "boundary": [
      {
        "case": "time-of-day",
        "action": "use-instead",
        "keywords": {
          "en": [
            "time-of-day",
            "clock-time"
          ],
          "de": [
            "tageszeit",
            "uhrzeitfeld"
          ]
        },
        "kialo": "A time of day is no day of a calendar, because the hours lie inside one day; the kampo of kind time takes it beside the date.",
        "ero": "kampo"
      },
      {
        "case": "multiple-months",
        "action": "ask-human",
        "keywords": {
          "en": [
            "several-months",
            "two-months",
            "months-side-by-side"
          ],
          "de": [
            "mehrere-monate",
            "zwei-monate",
            "monate-nebeneinander"
          ]
        },
        "kialo": "Two or more months side by side are a layout of their own, because the grid grows beyond the field it belongs to; a person decides whether a product wants it."
      },
      {
        "case": "presets",
        "action": "ask-human",
        "keywords": {
          "en": [
            "presets",
            "last-7-days",
            "shortcuts",
            "quick-ranges"
          ],
          "de": [
            "vorgaben",
            "letzte-7-tage",
            "schnellwahl",
            "voreinstellungen"
          ]
        },
        "kialo": "Presets like the last seven days are choices beside the calendar, because they name ranges a product knows; a person decides which ones and where they stand."
      }
    ],
    "composes": {
      "containers": [
        {
          "name": "form",
          "kialo": "A date picker without a form has no sender, because the date is only sent with the form."
        },
        {
          "name": "dialog",
          "kialo": "A dialog may ask for a date before it ends, because the decision it ends in may need one."
        }
      ],
      "with": [
        {
          "ero": "kampo",
          "kialo": "A date picker stands among the fields of a form, because a date is one entry of many; a time of day beside it is a kampo of kind time."
        },
        {
          "ero": "butono",
          "kialo": "The form ends with the button that sends it, because choosing a date does nothing by itself."
        }
      ],
      "never": [
        {
          "ero": "butono",
          "kialo": "A date picker stands in no slot of a button, because a button is one target with one name and the calendar could not be reached on its own."
        }
      ],
      "spacing": {
        "owner": "container",
        "regulo": "spacing-owned-by-container"
      }
    },
    "slots": {
      "label": {
        "accepts": [
          "text"
        ],
        "required": true,
        "max": 1,
        "nesting": 0
      },
      "help": {
        "accepts": [
          "text"
        ],
        "max": 1,
        "nesting": 0
      },
      "error": {
        "accepts": [
          "text"
        ],
        "max": 1,
        "nesting": 0
      }
    },
    "layout": {
      "size": "container",
      "wrap": "never"
    },
    "content": [
      {
        "regulo": "field-label-names-the-datum",
        "fixed": false,
        "check": {
          "kind": "not-words",
          "words": {
            "de": [
              "wählen",
              "auswählen",
              "eingeben"
            ],
            "en": [
              "choose",
              "pick",
              "enter"
            ]
          }
        }
      },
      {
        "regulo": "error-says-what-to-do",
        "fixed": true,
        "of": "slot:error",
        "check": {
          "kind": "min-words",
          "count": 3
        }
      },
      {
        "regulo": "help-is-one-sentence",
        "fixed": false,
        "of": "slot:help",
        "check": {
          "kind": "max-sentences",
          "count": 1
        }
      }
    ]
  }
}
