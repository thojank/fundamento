    "a11y": {
      "role": "textbox",
      "name": [
        "slot:label"
      ],
      "description": [
        "slot:help",
        "slot:error",
        "slot:disabled-reason"
      ],
      "states": {
        "required": [
          "aria-required"
        ],
        "invalid": [
          "aria-invalid"
        ],
        "disabled": [
          "aria-disabled"
        ],
        "readonly": [
          "aria-readonly"
        ],
        "expanded": [
          "aria-expanded"
        ],
        "loading": [
          "aria-busy"
        ]
      },
      "keys": [
        "ArrowDown",
        "ArrowUp",
        "ArrowLeft",
        "ArrowRight",
        "PageUp",
        "PageDown",
        "Home",
        "End",
        "Enter",
        "Escape"
      ],
      "texts": {
        "required": {
          "de": "erforderlich",
          "en": "required"
        },
        "trigger-name": {
          "de": "Kalender öffnen",
          "en": "Open calendar"
        },
        "prev-name": {
          "de": "Voriger Monat",
          "en": "Previous month"
        },
        "next-name": {
          "de": "Nächster Monat",
          "en": "Next month"
        },
        "value-invalid": {
          "de": "Gib ein Datum wie {example} ein.",
          "en": "Enter a date like {example}."
        },
        "value-end-invalid": {
          "de": "Wähle ein Ende nach dem Anfang.",
          "en": "Choose an end after the start."
        },
        "loading": {
          "de": "lädt",
          "en": "loading"
        },
        "clear-name": {
          "de": "{label} leeren",
          "en": "Clear {label}"
        }
      }
    },
    "events": [
      {
        "name": "input",
        "description": "The text in the field changes while a person types a date."
      },
      {
        "name": "change",
        "description": "A date is picked in the calendar, or a typed date is valid and the field is left or Enter is pressed."
      }
    ],
    "constraints": [
      {
        "when": {
          "slot:error": "filled"
        },
        "allowed": {
          "invalid": [
            "true"
          ]
        },
        "kialo": "An error text without the error state is a contradiction a screen reader cannot resolve, because it reads a fault on a field that says it is fine."
      },
      {
        "when": {
          "disabled": "true"
        },
        "allowed": {
          "readonly": [
            "false"
          ]
        },
        "kialo": "Two reasons why one cannot choose are one too many, because disabled wins."
      },
      {
        "when": {
          "prop:value": "filled"
        },
        "allowed": {
          "mode": [
            "single"
          ]
        },
        "kialo": "One date is a single choice, because a range has a start and an end of its own (value-start, value-end)."
      },
      {
        "when": {
          "prop:value-start": "filled"
        },
        "allowed": {
          "mode": [
            "range"
          ]
        },
        "kialo": "A start needs an end to stand against, because without mode range the one date is value."
      },
      {
        "when": {
          "prop:value-end": "filled"
        },
        "allowed": {
          "mode": [
            "range"
          ]
        },
        "kialo": "An end needs a start to stand against, because without mode range the one date is value."
      },
      {
        "when": {
          "slot:disabled-reason": "filled"
        },
        "allowed": {
          "disabled": [
            "true"
          ]
        },
        "kialo": "A reason without disabled is a contradiction, because it says why something is blocked that is not."
      }
    ],
    "goals": [
      {
        "goal": "pick-date",
        "keywords": {
          "en": [
            "date-picker",
            "calendar",
            "delivery-date",
            "booking-date",
            "due-date"
          ],
          "de": [
            "kalender",
            "datumsauswahl",
            "lieferdatum",
            "buchungsdatum",
            "fälligkeit"
          ]
        },
        "props": {},
        "regulo": "field-label-visible"
      },
      {
        "goal": "date-range",
        "keywords": {
          "en": [
            "date-range",
            "period",
            "timeframe"
          ],
          "de": [
            "zeitraum",
            "berichtszeitraum",
            "datumsbereich",
            "zeitspanne"
          ]
        },
        "props": {
          "mode": "range"
        },
        "regulo": "field-label-visible"
      }
    ]
