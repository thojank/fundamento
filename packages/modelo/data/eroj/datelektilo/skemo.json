{
  "ero": {
    "id": "ero_01M5GYYCPEQ6SKJGPDKMFVZCAQ",
    "name": "datelektilo",
    "skemo": "ske_01M5GYYD31C6C7EN316YWX0FYY",
    "description": "A date picker: lets a person choose a date or a date range near today, typed into the field or picked from a calendar. It always shows its label; the calendar opens beside the field and closes with the choice."
  },
  "skemo": {
    "id": "ske_01M5GYYD31C6C7EN316YWX0FYY",
    "ero": "ero_01M5GYYCPEQ6SKJGPDKMFVZCAQ",
    "props": [
      {
        "name": "mode",
        "kind": "enum",
        "values": [
          "single",
          "range"
        ],
        "default": "single",
        "description": "single: one date (value); range: a start and an end (value-start, value-end), the end never before the start."
      },
      {
        "name": "value",
        "kind": "string",
        "description": "The chosen date as an ISO date (YYYY-MM-DD), with mode single; shown and typed in the format of the document's language (lang)."
      },
      {
        "name": "value-start",
        "kind": "string",
        "description": "The first date of a range as an ISO date, with mode range."
      },
      {
        "name": "value-end",
        "kind": "string",
        "description": "The last date of a range as an ISO date, with mode range; at or after value-start."
      },
      {
        "name": "min",
        "kind": "string",
        "description": "The earliest date a person may choose, an ISO date; earlier days are refused in the calendar and when typed."
      },
      {
        "name": "max",
        "kind": "string",
        "description": "The latest date a person may choose, an ISO date."
      },
      {
        "name": "disabled-dates",
        "kind": "string",
        "description": "Days that cannot be chosen: a list of ISO dates separated by commas, or the rule weekends (Saturday and Sunday)."
      },
      {
        "name": "required",
        "kind": "boolean",
        "default": false,
        "description": "A date must be chosen; marked visibly and audibly (Regulo required-marked)."
      },
      {
        "name": "disabled",
        "kind": "boolean",
        "default": false,
        "description": "Cannot be used: the field takes no text, the calendar does not open; skipped by the keyboard."
      },
      {
        "name": "loading",
        "kind": "boolean",
        "default": false,
        "description": "Spec 029 ②b-1 M-5: the application loads or checks (a value saved, a list fetched, a file examined): the field says so (aria-busy, described by a11y.texts loading) and shows the turning spinner; it stays operable."
      },
      {
        "name": "readonly",
        "kind": "boolean",
        "default": false,
        "description": "Can be read and focused, not changed: the field keeps its date, the calendar does not open."
      },
      {
        "name": "invalid",
        "kind": "boolean",
        "default": false,
        "description": "The chosen date is wrong; the error slot says what to do."
      },
      {
        "name": "expanded",
        "kind": "boolean",
        "default": false,
        "description": "The calendar is open. The element sets it while the calendar shows; set by the application it opens the calendar."
      },
      {
        "name": "name",
        "kind": "string",
        "description": "The name under which the form sends the date (ISO), a range as one ISO interval (start/end)."
      },
      {
        "name": "clearable",
        "kind": "boolean",
        "default": false,
        "description": "Spec 029 ②b-1 M-6: a clear button in the field, shown while it has a value and is neither disabled nor read-only, named „{label} leeren“; a press empties the value and returns the focus to the field."
      }
    ],
    "states": [
      "rest",
      "hover",
      "focus",
      "disabled",
      "readonly",
      "invalid"
    ],
    "slots": [
      {
        "name": "label",
        "default": true,
        "text": true
      },
      {
        "name": "help",
        "text": true
      },
      {
        "name": "error",
        "text": true
      },
      {
        "name": "disabled-reason",
        "text": true
      }
    ],
