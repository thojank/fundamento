            },
            {
              "$ref": "#/$defs/JugxoArtikoloRef"
            }
          ]
        },
        "decision": {
          "type": "string",
          "enum": ["approved", "rejected", "deviation-recorded"]
        },
        "kialo": {
          "$ref": "#/$defs/NonEmptyText"
        },
        "date": {
          "type": "string",
          "format": "date"
        },
        "context": {
          "type": "string"
        },
        "aspekto": {
          "description": "Scopes the entry to one Aspekto; entries in an Aspekto package carry their Aspekto (Spec 001, D-10).",
          "$ref": "#/$defs/Name"
        }
      },
      "required": ["id", "ref", "decision", "kialo", "date", "context"],
      "additionalProperties": false
    },
    "JugxojFile": {
      "type": "object",
      "properties": {
        "jugxoj": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Jugxo"
          }
        }
      },
      "required": ["jugxoj"],
      "additionalProperties": false
    },
    "KontrastParo": {
      "type": "object",
