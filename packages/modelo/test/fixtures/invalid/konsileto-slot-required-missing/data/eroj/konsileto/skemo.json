      {
        "name": "for",
        "kind": "string",
        "required": true,
        "description": "The id of the control the tooltip describes (its trigger): the tooltip appears while that control is hovered or focused and is heard as its description (aria-describedby) — unless its text is the control's own name, then it is not spoken twice."
      },
      {
        "name": "placement",
        "kind": "enum",
        "values": [
          "block-start",
          "block-end",
          "inline-start",
          "inline-end"
        ],
        "default": "block-start",
        "description": "Where the layer stands against its trigger, in logical directions (position-area of the platform); where that side has no room, the platform flips it (position-try-fallbacks). Layout, no token: it keys no part."
      }
