  "focus": {
    "ring": {
      "$type": "border",
      "$value": {
        "color": "{color.focus.ring}",
        "width": "{border.width.focus}",
        "style": "{stroke.solid}"
      }
    },
    "offset": {
      "$type": "dimension",
      "$value": "{spacing.scale.50}"
    }
  },
  "opacity": {
    "$type": "number",
    "disabled": {
      "$value": 0.38
    },
    "overlay": {
      "$value": 0.5
    },
    "hover": {
      "$value": 0.08
    },
    "pressed": {
      "$value": 0.12
    }
  }
}
