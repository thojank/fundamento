{
  "$extensions": {
    "com.ciferecigo.fundamento": {
      "id": "set_ekz_01M2X80VENR6M9X2JCA7G5E7B0",
      "kondicxoj": [
        "aspekto=ekzemplo",
        "color-scheme=light",
        "contrast=high"
      ]
    }
  },
  "color": {
    "$type": "color",
    "status": {
      "warning": {
        "on": {
          "$value": "{color.palette.neutral.0}"
        }
      }
    },
    "text": {
      "subtle": {
        "$value": "{color.palette.neutral.900}"
      },
      "muted": {
        "$value": "{color.palette.neutral.800}"
      }
    },
    "action": {
      "primary": {
        "rest": {
          "$value": "{color.palette.accent.100}"
        },
        "hover": {
          "$value": "{color.palette.accent.200}"
        },
        "pressed": {
          "$value": "{color.palette.accent.300}"
        },
        "selected": {
          "$value": "{color.palette.accent.200}"
        }
      },
      "secondary": {
        "text": {
          "$value": "{color.palette.neutral.0}"
        }
      }
    },
    "brand": {
      "fill": {
        "$value": "{color.palette.accent.100}"
      }
    },
    "focus": {
      "ring": {
        "$value": "{color.palette.neutral.1000}"
      }
    }
  }
}
