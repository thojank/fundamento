{
  "name": "@fundamento/ekranoj",
  "version": "0.2.0",
  "description": "Fundamento Ekranoj (Spec 037): one sentence and one brand become up to five linked, self-checked screens. An MCP client only; the scorer, the tools, the chat model, the renderer and the brand build are injected.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit && biome check ."
  },
  "dependencies": {
    "@axe-core/playwright": "4.13.0",
    "@fundamento/metiejo": "workspace:*",
    "@modelcontextprotocol/client": "2.0.0",
    "playwright": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
