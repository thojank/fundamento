{
  "name": "@fundamento/mcp",
  "version": "0.1.0",
  "description": "Fundamento MCP server: read-only tools and resources over the Modelo export.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "fundamento-mcp": "dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "perf": "vitest run --config vitest.perf.config.ts",
    "lint": "tsc -p tsconfig.json --noEmit && biome check ."
  },
  "dependencies": {
    "@fundamento/modelo": "workspace:*",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/node": "^24.13.5",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
