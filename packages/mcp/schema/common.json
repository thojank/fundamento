{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fundamento:schema:mcp:common",
  "description": "Shapes shared by the tools of @fundamento/mcp (Spec 001, contracts/mcp-tools.md).",
  "$defs": {
    "Issue": {
      "type": "object",
      "properties": {
        "rule": {
          "type": "string",
          "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "severity": {
          "enum": ["error", "warning", "info"]
        },
        "path": {
          "type": "string"
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "suggestion": {
          "type": "string",
          "minLength": 1
        },
        "combination": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "regulo": {
          "description": "The Regulo whose enforcer reported the issue, with its kialo (Spec 002, FR-08).",
          "type": "object",
          "properties": {
            "id": {
              "$ref": "urn:fundamento:schema:modelo#/$defs/ReguloId"
            },
            "name": {
              "$ref": "urn:fundamento:schema:modelo#/$defs/Name"
            },
            "kialo": { "type": "string", "minLength": 1 }
          },
          "required": ["id", "name", "kialo"],
          "additionalProperties": false
        }
      },
      "additionalProperties": false,
      "required": ["rule", "severity", "path", "message", "suggestion"]
    },
    "ErrorEnvelope": {
      "type": "object",
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "$ref": "urn:fundamento:schema:mcp:common#/$defs/Issue"
          },
          "minItems": 1
        },
        "allowed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nearest": {
          "description": "suggest_ero with nearest: true and no goal that answers (Spec 038 MG-6, D-33): the nearest goals of the Eroj, nearest first.",
          "type": "array",
          "items": {
            "$ref": "urn:fundamento:schema:mcp:common#/$defs/NearestGoal"
          }
        }
      },
      "additionalProperties": false,
      "required": ["issues"]
    },
    "NearestGoal": {
      "description": "A goal near a text no goal answers (Spec 038 MG-6): the Skemo goal, the Ero that declares it and its keywords.",
      "type": "object",
      "properties": {
        "celo": { "type": "string", "minLength": 1 },
        "ero": { "$ref": "urn:fundamento:schema:modelo#/$defs/Name" },
        "keywords": { "type": "array", "items": { "type": "string" } }
      },
      "required": ["celo", "ero", "keywords"],
      "additionalProperties": false
    },
    "UsageResult": {
      "description": "A judgement in the form of check_usage's answer (Spec 003 FR-13): how many instances, whether they hold, and every violation with the instances or Sxablonoj it is about.",
      "type": "object",
      "properties": {
        "instances": {
          "type": "integer",
          "minimum": 0
        },
        "valid": {
          "type": "boolean"
        },
        "violations": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "instance": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 0 },
                    "minItems": 1
                  },
                  "issue": { "$ref": "urn:fundamento:schema:mcp:common#/$defs/Issue" }
                },
                "required": ["instance", "issue"],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "sxablono": {
                    "type": "array",
                    "items": { "type": "integer", "minimum": 0 },
                    "minItems": 1
                  },
                  "issue": { "$ref": "urn:fundamento:schema:mcp:common#/$defs/Issue" }
                },
                "required": ["sxablono", "issue"],
                "additionalProperties": false
              }
            ]
          }
        }
      },
      "required": ["instances", "valid", "violations"],
      "additionalProperties": false
    },
    "RegionMarker": {
      "description": "How a region of a Sxablono is recognised in markup (Spec 038 MG-5): the landmark it is, an attribute that marks it, the slot value that puts a child into it, and default where it also takes the children without a slot attribute.",
      "type": "object",
      "properties": {
        "landmark": { "type": "string", "minLength": 1 },
        "attribute": { "type": "string", "minLength": 1 },
        "slot": { "type": "string", "minLength": 1 },
        "default": { "const": true }
      },
      "additionalProperties": false
    },
    "EroFieldName": {
      "description": "A part of an Ero that get_ero answers with fields (Spec 038 MG-3, MG-4).",
      "enum": ["brief", "slots", "role", "navigation", "constraints"]
    },
    "EroConstraints": {
      "description": "What an Ero's data allows and how its label is judged (Spec 038 B-3), each one line generated from the Skemo, the Uzo and the Regularo: props the allowed prop combinations (constraints naming props only), label the statements of the blocking label rules, grouped by their condition.",
      "type": "object",
      "properties": {
        "props": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 }
      },
      "minProperties": 1,
      "additionalProperties": false
    },
    "EroNavigation": {
      "description": "The prop that holds the target of a link Ero (Spec 038 MG-4).",
      "type": "object",
      "properties": {
        "target": { "$ref": "urn:fundamento:schema:modelo#/$defs/Name" }
      },
      "required": ["target"],
      "additionalProperties": false
    },
    "EroSlots": {
      "description": "Every slot of an Ero by name (Spec 038 MG-3), from Skemo and Uzo: what it lets in (text, icon, one Ero or several), its data form where the Modelo carries one, whether it is the default slot or required, and how many entries it takes.",
      "type": "object",
      "propertyNames": { "$ref": "urn:fundamento:schema:modelo#/$defs/Name" },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {
              "anyOf": [
                { "enum": ["text", "icon"] },
                {
                  "type": "object",
                  "properties": { "ero": { "$ref": "urn:fundamento:schema:modelo#/$defs/Name" } },
                  "required": ["ero"],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "eroj": {
                      "type": "array",
                      "items": { "$ref": "urn:fundamento:schema:modelo#/$defs/Name" },
                      "minItems": 1
                    }
                  },
                  "required": ["eroj"],
                  "additionalProperties": false
                }
              ]
            }
          },
          "dataForm": { "type": "string", "minLength": 1 },
          "default": { "const": true },
          "required": { "const": true },
          "min": { "type": "integer", "minimum": 0 },
          "max": { "type": "integer", "minimum": 0 }
        },
        "required": ["content"],
        "additionalProperties": false
      }
    },
    "FontSummary": {
      "type": "object",
      "properties": {
        "family": {
          "$ref": "urn:fundamento:schema:modelo#/$defs/NonEmptyText"
        },
        "license": {
          "$ref": "urn:fundamento:schema:modelo#/$defs/License"
        },
        "redistributable": {
          "type": "boolean"
        },
        "scripts": {
          "type": "array",
          "items": {
            "$ref": "urn:fundamento:schema:modelo#/$defs/Iso15924"
          },
          "minItems": 1
        }
      },
      "additionalProperties": false,
      "required": ["family", "license", "redistributable", "scripts"]
    },
    "AspektoSummary": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "urn:fundamento:schema:modelo#/$defs/Name"
        },
        "reference": {
          "type": "boolean"
        },
        "external": {
          "type": "boolean"
        },
        "owner": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "fonts": {
          "type": "array",
          "items": {
            "$ref": "urn:fundamento:schema:mcp:common#/$defs/FontSummary"
          }
        }
      },
      "additionalProperties": false,
      "required": ["name", "reference", "external", "owner", "license", "fonts"]
    },
    "AspektoDetail": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "urn:fundamento:schema:modelo#/$defs/Name"
        },
        "reference": {
          "type": "boolean"
        },
        "external": {
          "type": "boolean"
        },
        "owner": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "fonts": {
          "type": "array",
          "items": {
            "$ref": "urn:fundamento:schema:mcp:common#/$defs/FontSummary"
          }
        },
        "id": {
          "$ref": "urn:fundamento:schema:modelo#/$defs/DimensioValoroId"
        },
        "package": {
          "type": "string",
          "minLength": 1
        },
        "idNamespace": {
          "$ref": "urn:fundamento:schema:modelo#/$defs/IdNamespace"
        },
        "sets": {
          "type": "array",
          "items": {
            "$ref": "urn:fundamento:schema:modelo#/$defs/SetName"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "reference",
        "external",
        "owner",
        "license",
        "fonts",
        "id",
        "package",
        "sets"
      ]
    },
    "Branch": {
      "description": "One branch of a KontrastParo measured in one combination (Spec 002).",
      "type": "object",
      "properties": {
        "foreground": {
          "$ref": "urn:fundamento:schema:modelo#/$defs/TokenName"
        },
        "background": {
          "$ref": "urn:fundamento:schema:modelo#/$defs/TokenName"
        },
        "ratio": {
          "type": "number",
          "minimum": 1
        },
        "passed": {
          "type": "boolean"
        },
        "composited": {
          "type": "boolean"
        },
        "apca": {
          "type": "object",
          "properties": {
            "lc": {
              "type": "number",
              "minimum": 0
            },
            "threshold": {
              "type": "number"
            },
            "passed": {
              "type": "boolean"
            }
          },
          "required": ["lc"],
          "additionalProperties": false
        }
      },
      "required": ["foreground", "background", "ratio", "passed", "composited"],
      "additionalProperties": false
    },
    "PairResult": {
      "description": "A KontrastParo in one combination: the branch that carries it (main, aux, or null when both fail) (Spec 002).",
      "type": "object",
      "properties": {
        "threshold": {
          "type": "number",
          "minimum": 1
        },
        "passed": {
          "type": "boolean"
        },
        "branch": {
          "enum": ["main", "aux", null]
        },
        "main": {
          "$ref": "urn:fundamento:schema:mcp:common#/$defs/Branch"
        },
        "aux": {
          "$ref": "urn:fundamento:schema:mcp:common#/$defs/Branch"
        }
      },
      "required": ["threshold", "passed", "branch", "main"],
      "additionalProperties": false
    },
    "ReguloRef": {
      "description": "A Regulo as the Gvidanto cites it (Spec 002).",
      "type": "object",
      "properties": {
        "id": {
          "$ref": "urn:fundamento:schema:modelo#/$defs/ReguloId"
        },
        "name": {
          "$ref": "urn:fundamento:schema:modelo#/$defs/Name"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "kialo": {
          "type": "string",
          "minLength": 1
        },
        "checkability": {
          "enum": ["automatic", "manual"]
        },
        "aspekto": {
          "$ref": "urn:fundamento:schema:modelo#/$defs/Name"
        }
      },
      "required": ["id", "name", "statement", "kialo", "checkability"]
    }
  }
}
