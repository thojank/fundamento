{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ciferecigo.com/fundamento/schema/mcp/search_tokens.output.json",
  "title": "search_tokens output",
  "description": "Search tokens by prefix, type, role or text.",
  "type": "object",
  "properties": {
    "total": {
      "type": "integer",
      "minimum": 0
    },
    "tokens": {
      "type": "array",
      "items": {
        "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/TokenInventoryEntry"
      }
    }
  },
  "additionalProperties": false,
  "required": ["total", "tokens"]
}
