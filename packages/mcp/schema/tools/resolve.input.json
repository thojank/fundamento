{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fundamento:schema:mcp:resolve.input",
  "title": "resolve input",
  "description": "Resolve an assignment: value and provenance per token.",
  "type": "object",
  "properties": {
    "assignment": {
      "type": "object",
      "propertyNames": {
        "$ref": "urn:fundamento:schema:modelo#/$defs/Name"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
