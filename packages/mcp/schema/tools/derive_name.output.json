{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fundamento:schema:mcp:derive_name.output",
  "title": "derive_name output",
  "description": "The name of a token in each Celo (CSS, Figma, TypeScript, Tailwind, DTCG, Penpot).",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "derivations": {
      "type": "object",
      "properties": {
        "css": {
          "type": "string"
        },
        "figma": {
          "type": "string"
        },
        "typescript": {
          "type": "string"
        },
        "tailwind": {
          "type": "string"
        },
        "dtcg": {
          "type": "string"
        },
        "penpot": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "urn:fundamento:schema:mcp:common#/$defs/Issue"
      }
    }
  },
  "additionalProperties": false,
  "required": ["name", "derivations"]
}
