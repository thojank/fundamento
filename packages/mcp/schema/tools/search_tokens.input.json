{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ciferecigo.com/fundamento/schema/mcp/search_tokens.input.json",
  "title": "search_tokens input",
  "description": "Search tokens by prefix, type, role or text.",
  "type": "object",
  "properties": {
    "prefix": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/DtcgType"
    },
    "role": {
      "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/TokenRole"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 500
    },
    "offset": {
      "type": "integer",
      "minimum": 0
    }
  },
  "additionalProperties": false
}
