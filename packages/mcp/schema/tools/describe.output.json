{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ciferecigo.com/fundamento/schema/mcp/describe.output.json",
  "title": "describe output",
  "description": "What is here? Overview of the served Modelo.",
  "type": "object",
  "properties": {
    "version": {
      "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Version"
    },
    "dimensioj": {
      "type": "array",
      "items": {
        "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
      }
    },
    "aspektoj": {
      "type": "array",
      "items": {
        "$ref": "https://ciferecigo.com/fundamento/schema/mcp/common.json#/$defs/AspektoSummary"
      }
    },
    "tokens": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "byType": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "byGroup": {
          "type": "object",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false,
      "required": ["count", "byType", "byGroup"]
    },
    "reguloj": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "withKialo": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": ["count", "withKialo"]
    },
    "jugxoj": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": ["count"]
    },
    "eroj": {
      "type": "object",
      "properties": {
        "count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": ["count"]
    },
    "validation": {
      "type": "object",
      "properties": {
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": ["errors", "warnings"]
    },
    "sentence": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "dimensioj",
    "aspektoj",
    "tokens",
    "reguloj",
    "jugxoj",
    "eroj",
    "validation",
    "sentence"
  ]
}
