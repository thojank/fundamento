{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fundamento:schema:mcp:get_token.output",
  "title": "get_token output",
  "description": "One token with its core definition and every override.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "urn:fundamento:schema:modelo#/$defs/TokenId"
    },
    "name": {
      "$ref": "urn:fundamento:schema:modelo#/$defs/TokenName"
    },
    "type": {
      "$ref": "urn:fundamento:schema:modelo#/$defs/DtcgType"
    },
    "role": {
      "$ref": "urn:fundamento:schema:modelo#/$defs/TokenRole"
    },
    "description": {
      "type": "string"
    },
    "textTransform": {
      "$ref": "urn:fundamento:schema:modelo#/$defs/TextTransform"
    },
    "definition": {
      "type": "object",
      "properties": {
        "set": {
          "const": "core"
        },
        "value": {}
      },
      "additionalProperties": false,
      "required": ["set", "value"]
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "set": {
            "$ref": "urn:fundamento:schema:modelo#/$defs/SetName"
          },
          "package": {
            "type": "string",
            "minLength": 1
          },
          "kondicxoj": {
            "type": "array",
            "items": {
              "$ref": "urn:fundamento:schema:modelo#/$defs/KondicxoExpression"
            }
          },
          "value": {}
        },
        "additionalProperties": false,
        "required": ["set", "kondicxoj", "value"]
      }
    },
    "deveno": {
      "description": "Spec 029 ① (Constitution v2.4, Art. VII): where the values of this token come from when an Aspekto took them from a Fonto – per Aspekto and set, the Fonto, its file and key, its value, how it was taken and, for an adapted value, the Jugxo.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "aspekto": {
            "$ref": "urn:fundamento:schema:modelo#/$defs/Name"
          },
          "aro": { "type": "string", "minLength": 1 },
          "fonto": {
            "$ref": "urn:fundamento:schema:modelo#/$defs/Name"
          },
          "dosiero": { "type": "string", "minLength": 1 },
          "sxlosilo": { "type": "string", "minLength": 1 },
          "fontoValoro": { "type": "string", "minLength": 1 },
          "valoro": { "type": "string", "minLength": 1 },
          "maniero": { "type": "string", "minLength": 1 },
          "kampo": { "type": "string", "minLength": 1 },
          "jugxo": {
            "$ref": "urn:fundamento:schema:modelo#/$defs/JugxoId"
          },
          "kialo": { "type": "string", "minLength": 1 },
          "noto": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false,
        "required": ["aspekto", "aro", "fonto", "dosiero", "sxlosilo", "fontoValoro", "maniero"]
      }
    }
  },
  "additionalProperties": false,
  "required": ["id", "name", "type", "definition", "overrides"]
}
