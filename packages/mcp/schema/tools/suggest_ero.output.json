{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ciferecigo.com/fundamento/schema/mcp/suggest_ero.output.json",
  "title": "suggest_ero output",
  "description": "The Ero and the props a goal asks for, with the Regulo behind the choice (Spec 003 FR-13, contracts/mcp-tools §2; goal since F1-T00, Spec 007); or the boundary or alternative of a Uzo with its action and kialo (Spec 007 A9, D-06); or, when a boundary and a goal both hit, action ask-human with both candidates (OP-12).",
  "type": "object",
  "properties": {
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "matched": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "goal": {
              "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
            },
            "keyword": {
              "type": "string",
              "minLength": 1
            },
            "lingvo": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": ["goal", "keyword", "lingvo"],
          "additionalProperties": false
        }
      ]
    },
    "suggestion": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "ero": {
              "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
            },
            "props": {
              "type": "object",
              "propertyNames": {
                "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
              },
              "additionalProperties": {
                "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
              }
            }
          },
          "required": ["ero", "props"],
          "additionalProperties": false
        },
        {
          "description": "A Sxablono (Spec 020, G3): a pattern of Eroj; its regions stand in regions.",
          "type": "object",
          "properties": {
            "sxablono": {
              "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
            },
            "props": {
              "type": "object",
              "propertyNames": {
                "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
              },
              "additionalProperties": {
                "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
              }
            }
          },
          "required": ["sxablono", "props"],
          "additionalProperties": false
        }
      ]
    },
    "children": {
      "description": "What the goal of the suggested Sxablono names per region (Spec 020 ②): an Ero with its props.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "region": {
            "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
          },
          "ero": {
            "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
          },
          "props": {
            "type": "object",
            "additionalProperties": {
              "anyOf": [{ "type": "string" }, { "type": "boolean" }]
            }
          }
        },
        "required": ["region", "ero"],
        "additionalProperties": false
      }
    },
    "regions": {
      "description": "The regions of the suggested Sxablono (Spec 020): name, whether required, what it accepts.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
          },
          "required": {
            "type": "boolean"
          },
          "accepts": {
            "type": "array",
            "items": {
              "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
            }
          }
        },
        "required": ["name"],
        "additionalProperties": false
      }
    },
    "kialo": {
      "type": "string",
      "minLength": 1
    },
    "regulo": {
      "$ref": "https://ciferecigo.com/fundamento/schema/mcp/common.json#/$defs/ReguloRef"
    },
    "boundary": {
      "description": "The boundary or alternative of a Uzo that answers (Spec 007). ask-human: a person decides; use-instead: suggestion names the Ero; not-supported: the Ero stops there.",
      "type": "object",
      "properties": {
        "ero": {
          "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
        },
        "case": {
          "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
        },
        "action": {
          "enum": ["use-instead", "ask-human", "not-supported"]
        },
        "kialo": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": ["ero", "case", "action", "kialo"],
      "additionalProperties": false
    },
    "action": {
      "description": "ask-human when a boundary and a goal both hit: Fundamento picks no reading (OP-12).",
      "const": "ask-human"
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "boundary"
              },
              "ero": {
                "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
              },
              "case": {
                "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
              },
              "action": {
                "enum": ["use-instead", "ask-human", "not-supported"]
              },
              "kialo": {
                "type": "string",
                "minLength": 1
              },
              "keyword": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": ["kind", "ero", "case", "action", "kialo", "keyword"],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "const": "goal"
              },
              "ero": {
                "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
              },
              "goal": {
                "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
              },
              "props": {
                "type": "object",
                "propertyNames": {
                  "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
                },
                "additionalProperties": {
                  "anyOf": [{ "type": "string" }, { "type": "number" }, { "type": "boolean" }]
                }
              },
              "keyword": {
                "type": "string",
                "minLength": 1
              },
              "kialo": {
                "type": "string",
                "minLength": 1
              },
              "regulo": {
                "$ref": "https://ciferecigo.com/fundamento/schema/mcp/common.json#/$defs/ReguloRef"
              }
            },
            "required": ["kind", "ero", "goal", "props", "keyword"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["goal", "matched", "suggestion"],
  "additionalProperties": false
}
