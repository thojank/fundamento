{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "list_sxablonoj output",
  "description": "The Sxablonoj (Spec 020, G3), sorted by name, each with its ID, kind (layout, page, flow), description and the names of its regions.",
  "type": "object",
  "properties": {
    "sxablonoj": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "pattern": "^sxa_" },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["layout", "page", "flow"] },
          "description": { "type": "string", "minLength": 1 },
          "regions": { "type": "array", "items": { "type": "string", "minLength": 1 } }
        },
        "required": ["id", "name", "kind", "description", "regions"],
        "additionalProperties": false
      }
    }
  },
  "required": ["sxablonoj"],
  "additionalProperties": false
}
