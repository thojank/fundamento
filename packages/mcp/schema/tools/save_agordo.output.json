{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ciferecigo.com/fundamento/schema/mcp/save_agordo.output.json",
  "title": "save_agordo output",
  "description": "What save_agordo wrote, or would write: the path relative to the working directory, whether a file was there, the Agordo with its historio, the new entry, the bytes of the file, and the report's summary. writes is true only after confirm.",
  "type": "object",
  "properties": {
    "writes": {
      "type": "boolean"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "exists": {
      "type": "boolean"
    },
    "agordo": {
      "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Agordo"
    },
    "entry": {
      "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/AgordoHistorio"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "exportable": {
      "type": "boolean"
    },
    "summary": {
      "type": "object",
      "properties": {
        "exportable": {
          "type": "boolean"
        },
        "pairs": {
          "type": "object",
          "properties": {
            "measured": {
              "type": "integer",
              "minimum": 0
            },
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["measured", "passed", "failed"],
          "additionalProperties": false
        },
        "violations": {
          "type": "object",
          "properties": {
            "fixed": {
              "type": "integer",
              "minimum": 0
            },
            "adjustable": {
              "type": "integer",
              "minimum": 0
            },
            "covered": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": ["fixed", "adjustable", "covered"],
          "additionalProperties": false
        },
        "hints": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": ["exportable", "pairs", "violations", "hints"],
      "additionalProperties": false
    }
  },
  "required": ["writes", "path", "exists", "agordo", "entry", "text", "exportable", "summary"],
  "additionalProperties": false
}
