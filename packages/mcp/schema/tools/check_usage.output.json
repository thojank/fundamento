{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fundamento:schema:mcp:check_usage.output",
  "title": "check_usage output",
  "description": "What the Ero Reguloj say about the given instances (Spec 003 FR-13, contracts/mcp-tools §3). Each violation names the instances it is about and carries the Regulo with its kialo.",
  "type": "object",
  "properties": {
    "instances": {
      "type": "integer",
      "minimum": 0
    },
    "valid": {
      "type": "boolean"
    },
    "violations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "instance": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 1
              },
              "issue": {
                "$ref": "urn:fundamento:schema:mcp:common#/$defs/Issue"
              }
            },
            "required": ["instance", "issue"],
            "additionalProperties": false
          },
          {
            "description": "A violation of a Sxablono instance (Spec 020): its index in sxablonoj.",
            "type": "object",
            "properties": {
              "sxablono": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 1
              },
              "issue": {
                "$ref": "urn:fundamento:schema:mcp:common#/$defs/Issue"
              }
            },
            "required": ["sxablono", "issue"],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": ["instances", "valid", "violations"],
  "additionalProperties": false
}
