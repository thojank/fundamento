{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ciferecigo.com/fundamento/schema/mcp/check_usage.output.json",
  "title": "check_usage output",
  "description": "What the Ero Reguloj say about the given instances (Spec 003 FR-13, contracts/mcp-tools §3). Each violation names the instances it is about and carries the Regulo with its kialo.",
  "type": "object",
  "properties": {
    "instances": {
      "type": "integer",
      "minimum": 0
    },
    "valid": {
      "type": "boolean"
    },
    "violations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "instance": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 0
            },
            "minItems": 1
          },
          "issue": {
            "$ref": "https://ciferecigo.com/fundamento/schema/mcp/common.json#/$defs/Issue"
          }
        },
        "required": ["instance", "issue"],
        "additionalProperties": false
      }
    }
  },
  "required": ["instances", "valid", "violations"],
  "additionalProperties": false
}
