{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ciferecigo.com/fundamento/schema/mcp/list_eroj.output.json",
  "title": "list_eroj output",
  "description": "The Eroj of the served Modelo, in Modelo order (Spec 003 FR-13).",
  "type": "object",
  "properties": {
    "eroj": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/EroId"
          },
          "name": {
            "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "variants": {
            "type": "array",
            "items": {
              "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
            }
          },
          "props": {
            "type": "array",
            "items": {
              "$ref": "https://ciferecigo.com/fundamento/schema/modelo.schema.json#/$defs/Name"
            }
          }
        },
        "required": ["id", "name", "description", "variants", "props"],
        "additionalProperties": false
      }
    }
  },
  "required": ["eroj"],
  "additionalProperties": false
}
