{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fundamento:schema:mcp:validate.output",
  "title": "validate output",
  "description": "Validation issues of the served Modelo or of a local Aspekto package.",
  "type": "object",
  "properties": {
    "valid": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "$ref": "urn:fundamento:schema:mcp:common#/$defs/Issue"
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "urn:fundamento:schema:mcp:common#/$defs/Issue"
      }
    },
    "scope": {
      "enum": ["served", "package"]
    }
  },
  "additionalProperties": false,
  "required": ["valid", "errors", "warnings", "scope"]
}
