{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:fundamento:schema:mcp:list_dimensioj.output",
  "title": "list_dimensioj output",
  "description": "The Dimensioj with values, default, priority and sets.",
  "type": "object",
  "properties": {
    "dimensioj": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "$ref": "urn:fundamento:schema:modelo#/$defs/Name"
          },
          "priority": {
            "type": "integer",
            "minimum": 1
          },
          "default": {
            "$ref": "urn:fundamento:schema:modelo#/$defs/Name"
          },
          "valoroj": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "$ref": "urn:fundamento:schema:modelo#/$defs/Name"
                },
                "sets": {
                  "type": "array",
                  "items": {
                    "$ref": "urn:fundamento:schema:modelo#/$defs/SetName"
                  }
                }
              },
              "additionalProperties": false,
              "required": ["name", "sets"]
            }
          }
        },
        "additionalProperties": false,
        "required": ["name", "priority", "default", "valoroj"]
      }
    },
    "order": {
      "type": "string",
      "minLength": 1
    }
  },
  "additionalProperties": false,
  "required": ["dimensioj", "order"]
}
