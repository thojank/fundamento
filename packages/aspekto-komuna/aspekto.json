  "aspiroj": [
    {
      "metriko": "wcag2-reserve",
      "min": 0.1,
      "kialo": "Die Referenzmarke soll vormachen, was erreichbar ist: zehn Prozent Reserve über der Schwelle halten auch auf schlechten Bildschirmen und bei weicher Schriftglättung. Für andere Marken bleibt die Regulo bei fünf Prozent."
    },
    {
      "metriko": "oklch-l-extreme",
      "min": 0.02,
      "appliesTo": {
        "tokens": [
          "color.background.**",
          "color.action.*.rest",
          "color.action.*.hover",
          "color.action.*.pressed",
          "color.action.*.selected",
          "color.action.*.disabled",
          "color.status.*.basic",
          "color.status.*.weak",
          "color.status.*.subtle"
        ]
      },
      "kialo": "Reines Weiß und reines Schwarz lassen keinen Platz mehr nach oben oder unten; komuna hält jede Fläche einen Schritt von den Ankern entfernt — die Seitenflächen ebenso wie die Flächen von Aktionen und Status, damit der Dunkelmodus ein Entwurf bleibt und kein Spiegelbild. Durchsichtige Werte bleiben außen vor: eine Auflage hat keine eigene Fläche."
    },
    {
      "metriko": "type-scale-ratio",
      "min": 1.1,
      "max": 1.3,
      "appliesTo": {
        "tokens": ["font.size.scale.*"]
      },
      "kialo": "Ein ruhiges Band zwischen 1,10 und 1,30 macht die Skala berechenbar und lässt eine abgeleitete Marke sie nachrechnen."
    },
    {
      "metriko": "oklch-l-step",
      "min": 0.04,
      "max": 0.2,
      "appliesTo": {
        "tokens": ["color.palette.**"]
      },
      "kialo": "Eine feste Schrittweite lässt alle Rampen gleich schnell laufen; wer eine Stufe wechselt, bekommt überall dieselbe Wirkung."
    },
    {
      "metriko": "dimensio-kovrado",
      "dimensio": "color-scheme",
      "valoro": "dark",
      "min": 1,
      "appliesTo": {
        "tokens": ["color.background.**", "color.text.**", "color.action.**", "color.status.**"]
      },
      "kialo": "Ein Dunkelmodus, den alle Marken teilen, ist eine Umsetzung, kein Entwurf. komuna bestimmt Flächen, Text, Aktionen und Status im Dunkeln selbst."
    }
  ]
}
